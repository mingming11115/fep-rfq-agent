map $http_x_forwarded_proto $rfq_forwarded_proto {
    default $http_x_forwarded_proto;
    '' $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 64m;

    # Docker DNS is resolved on requests, so a backend restart does not leave
    # nginx using the previous container's IP address.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $rfq_api ${RFQ_API_UPSTREAM};
    set $rfq_office ${RFQ_OFFICE_UPSTREAM};

    gzip_static on;
    gzip_vary on;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location = /backend-health {
        proxy_pass http://$rfq_api/actuator/health;
        include /etc/nginx/rfq-proxy.conf;
    }
    location ^~ /api/rfq/ {
        proxy_pass http://$rfq_api;
        include /etc/nginx/rfq-proxy.conf;
    }
    location ^~ /api/craft/ {
        proxy_pass http://$rfq_api;
        include /etc/nginx/rfq-proxy.conf;
    }
    location ^~ /api/office/ {
        proxy_pass http://$rfq_office;
        include /etc/nginx/rfq-proxy.conf;
    }

    # Editor JS/WASM names are fixed. Always revalidate the whole runtime,
    # including nested snippet imports; never return SPA HTML for a missing file.
    location ^~ /craft-editors/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location = /.editor-assets.sha256 { return 404; }
    location ~* \.(js|css|wasm|pdf|docx|svg|ico|png|woff2?)$ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
