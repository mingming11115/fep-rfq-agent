+/// Keep PdfCraft's normal lifecycle while letting an opted-in host own the comment sidebar.
+#[cfg(target_arch = "wasm32")]
+struct WebShell {
+    app: pdfcraft_ui_egui::PdfCraftApp,
+    review: Option<host::Bridge>,
+    last_review: String,
+}
+
+#[cfg(target_arch = "wasm32")]
+impl eframe::App for WebShell {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        // Opens are consumed by `app.logic`: commands still refer to the document the host
+        // saw before that open, so apply them first and let the app check their document id.
+        if let Some(review) = &self.review {
+            review.drain_review(&mut self.app);
+        }
+        self.app.logic(ctx, frame);
+        if self.review.is_some() {
+            self.app.host_review_tick();
+        }
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.app.ui(ui, frame);
+        if let Some(review) = &self.review {
+            let state = self.app.host_review_snapshot(ui.ctx(), review.review_sequence()).to_string();
+            if state != self.last_review && review.post_review(&state) {
+                self.last_review = state;
+            }
+        }
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw: &mut egui::RawInput) {
+        self.app.raw_input_hook(ctx, raw);
+    }
+
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.app.save(storage);
+    }
+
+    fn on_exit(&mut self, gl: Option<&eframe::glow::Context>) {
+        self.app.on_exit(gl);
+    }
+
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.app.auto_save_interval()
+    }
+
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.app.clear_color(visuals)
+    }
+
+    fn persist_egui_memory(&self) -> bool {
+        self.app.persist_egui_memory()
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        self.app.as_any_mut()
+    }
 }
 
