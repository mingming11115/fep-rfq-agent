+#[cfg(test)]
+mod comment_key_tests {
+    use super::*;
+    use crate::{NewAnnotation, NoteIcon, ReviewState, Session, Shape, Style};
+
+    fn blank() -> (Session, DocId) {
+        let mut session = Session::new().with_clock(|| 1_700_000_000);
+        let bytes = session.create_blank(200.0, 300.0, 1).unwrap();
+        let id = session.open("comments.pdf", None, bytes, None).unwrap();
+        (session, id)
+    }
+
+    fn note(text: &str) -> Edit {
+        let shape = Shape::Note { at: [50.0, 100.0], icon: NoteIcon::Comment };
+        Edit::AddAnnotation(NewAnnotation { page: 0, style: Style::default_for(&shape), shape, contents: text.into(), author: "Reviewer".into() })
+    }
+
+    fn comment_slot(doc: &Document, text: &str) -> (usize, usize) {
+        let annotation = doc.info.annotations.iter().find(|a| a.contents.as_deref() == Some(text)).unwrap();
+        (annotation.page, annotation.index)
+    }
+
+    fn comment_key(doc: &Document, slot: (usize, usize)) -> String {
+        doc.comment_keys().into_iter().find(|(page, index, _)| (*page, *index) == slot).unwrap().2
+    }
+
+    #[test]
+    fn comment_keys_survive_deleting_an_earlier_annotation() {
+        let (mut session, id) = blank();
+        session.apply(id, note("Earlier")).unwrap();
+        session.apply(id, note("Later")).unwrap();
+        let doc = session.get(id).unwrap();
+        let earlier = comment_slot(doc, "Earlier");
+        let later = comment_slot(doc, "Later");
+        let earlier_key = comment_key(doc, earlier);
+        let later_key = comment_key(doc, later);
+        assert!(earlier.1 < later.1);
+        assert_ne!(earlier_key, later_key);
+        session.apply(id, Edit::DeleteAnnotation { page: earlier.0, index: earlier.1 }).unwrap();
+        let doc = session.get(id).unwrap();
+        let shifted = comment_slot(doc, "Later");
+        assert!(shifted.1 < later.1, "deleting the earlier note and its popup shifts the later native index");
+        assert_eq!(comment_key(doc, shifted), later_key, "the later note keeps its identity after reindexing");
+        assert!(!doc.comment_keys().iter().any(|(_, _, key)| *key == earlier_key));
+        assert!(!doc.info.annotations.iter().any(|a| a.contents.as_deref() == Some("Earlier")));
+    }
+
+    #[test]
+    fn comment_keys_survive_edits_undo_and_incremental_save_reopen() {
+        let (mut session, id) = blank();
+        session.apply(id, note("Original")).unwrap();
+        let doc = session.get(id).unwrap();
+        let (page, index) = comment_slot(doc, "Original");
+        let before = doc.comment_keys();
+        session.apply(id, Edit::SetAnnotationContents { page, index, text: "Edited".into() }).unwrap();
+        session.apply(id, Edit::MoveAnnotation { page, index, dx: 15.0, dy: 0.0 }).unwrap();
+        assert_eq!(session.get(id).unwrap().comment_keys(), before);
+        session.undo(id).unwrap();
+        assert_eq!(session.get(id).unwrap().comment_keys(), before);
+        session.redo(id).unwrap();
+        let bytes = session.save_bytes(id).unwrap();
+        session.mark_saved(id, bytes.clone(), None).unwrap();
+        assert_eq!(session.get(id).unwrap().comment_keys(), before);
+        let mut reopened = Session::new();
+        let reopened_id = reopened.open("saved.pdf", None, bytes, None).unwrap();
+        assert_eq!(reopened.get(reopened_id).unwrap().comment_keys(), before);
+    }
+
+    #[test]
+    fn comment_keys_include_replies_status_and_inline_popups() {
+        use pdfcraft_cos::{Dict, Object};
+        let (mut session, id) = blank();
+        session.apply(id, note("Root")).unwrap();
+        let (root_page, root_index) = comment_slot(session.get(id).unwrap(), "Root");
+        session.apply(id, Edit::ReplyToAnnotation { page: root_page, index: root_index, text: "Reply".into(), author: "Other".into() }).unwrap();
+        session
+            .apply(id, Edit::SetAnnotationStatus { page: root_page, index: root_index, state: ReviewState::Completed, author: "Other".into() })
+            .unwrap();
+        let mut cos = pdfcraft_cos::Document::open(session.get(id).unwrap().bytes.clone()).unwrap();
+        let page = pdfcraft_annot::page_refs(&cos).unwrap()[0];
+        let annots = cos.get(page).as_dict().unwrap().get(b"Annots").unwrap().clone();
+        let mut annots = cos.resolve(&annots).as_array().unwrap().clone();
+        assert!(annots.iter().any(|entry| cos.resolve(entry).as_dict().is_some_and(|dict| dict.name(b"Subtype") == Some(b"Popup"))));
+        let inline_index = annots.len();
+        let mut popup = Dict::new();
+        popup.set(b"Type".to_vec(), Object::name("Annot"));
+        popup.set(b"Subtype".to_vec(), Object::name("Popup"));
+        popup.set(b"Rect".to_vec(), Object::Array(vec![0.into(), 0.into(), 20.into(), 20.into()]));
+        annots.push(Object::Dict(popup));
+        let expected_count = annots.len();
+        pdfcraft_annot::set_annots(&mut cos, page, annots).unwrap();
+        let bytes = Arc::new(write_incremental(&cos, &SaveOptions::default()).unwrap());
+        let imported = session.open("popup.pdf", None, bytes, None).unwrap();
+        let doc = session.get(imported).unwrap();
+        let keys = doc.comment_keys();
+        assert_eq!(keys.iter().map(|(p, i, _)| (*p, *i)).collect::<Vec<_>>(), (0..expected_count).map(|i| (0, i)).collect::<Vec<_>>());
+        assert_eq!(keys.iter().map(|(_, _, key)| key).collect::<std::collections::HashSet<_>>().len(), expected_count);
+        let reply = comment_slot(doc, "Reply");
+        let reply_key = comment_key(doc, reply);
+        let root_key = comment_key(doc, comment_slot(doc, "Root"));
+        let status = doc.info.annotations.iter().find(|a| a.state.as_deref() == Some("Completed")).unwrap();
+        assert!(keys.iter().any(|(page, index, _)| (*page, *index) == (status.page, status.index)), "status records have keys too");
+        let inline_key = comment_key(doc, (0, inline_index));
+        session.apply(imported, Edit::DeleteAnnotation { page: reply.0, index: reply.1 }).unwrap();
+        let doc = session.get(imported).unwrap();
+        let after = doc.comment_keys();
+        assert!(!doc.info.annotations.iter().any(|a| a.contents.as_deref() == Some("Reply")), "the real reply was deleted");
+        assert!(!after.iter().any(|(_, _, key)| *key == reply_key));
+        assert_eq!(comment_key(doc, comment_slot(doc, "Root")), root_key, "deleting a reply preserves its parent");
+        assert!(doc.info.annotations.iter().any(|a| a.state.as_deref() == Some("Completed")), "the status sibling remains");
+        let shifted_inline = after.iter().find(|(_, _, key)| *key == inline_key).expect("inline popup keeps its content identity");
+        assert!(shifted_inline.1 < inline_index, "the inline popup's native index shifted after reply deletion");
+        let saved = session.save_bytes(imported).unwrap();
+        let mut reopened = Session::new();
+        let reopened_id = reopened.open("popup-saved.pdf", None, saved, None).unwrap();
+        assert_eq!(reopened.get(reopened_id).unwrap().comment_keys(), session.get(imported).unwrap().comment_keys());
+    }
+}
