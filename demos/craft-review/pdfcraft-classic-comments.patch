+    /// Opaque identities for every entry of each page's `/Annots`, including replies, status
+    /// records and pop-ups. The first two values are the current zero-based page and array index.
+    /// Indirect identities use the page and annotation object references, so deleting an earlier
+    /// annotation or editing this one does not change its key. Incremental Save/reopen keeps them;
+    /// a full rewrite may renumber objects and therefore change keys.
+    ///
+    /// Inline entries have a bounded content fingerprint and a same-content occurrence number.
+    /// Editing/promoting an inline entry can change its key; callers should migrate the identity
+    /// they already hold after their own mutation. Identical inline entries have no intrinsic
+    /// identity, so deleting one can change the occurrence numbers of its identical siblings.
+    /// At most a million entries are returned. Cache by [`Self::edit_generation`] between edits.
+    pub fn comment_keys(&self) -> Vec<(usize, usize, String)> {
+        let Some(editor) = &self.editor else { return Vec::new() };
+        let Ok(pages) = pdfcraft_annot::page_refs(&editor.cos) else { return Vec::new() };
+        let mut keys = Vec::new();
+        for (page, page_ref) in pages.into_iter().enumerate() {
+            let page_object = editor.cos.get(page_ref);
+            let Some(annots) = page_object.as_dict().and_then(|d| d.get(b"Annots")) else { continue };
+            let annots = editor.cos.resolve(annots);
+            let Some(annots) = annots.as_array() else { continue };
+            let mut occurrences = std::collections::HashMap::<u64, usize>::new();
+            for (index, annot) in annots.iter().enumerate() {
+                if keys.len() >= 1_000_000 {
+                    return keys;
+                }
+                let identity = match annot {
+                    pdfcraft_cos::Object::Ref(r) => format!("ref:{}:{}", r.num, r.generation),
+                    inline => {
+                        let fingerprint = comment_fingerprint(inline);
+                        let occurrence = occurrences.entry(fingerprint).or_default();
+                        let key = format!("inline:{fingerprint:016x}:{occurrence}");
+                        *occurrence += 1;
+                        key
+                    }
+                };
+                keys.push((page, index, format!("page:{}:{}/{}", page_ref.num, page_ref.generation, identity)));
+            }
+        }
+        keys
+    }
