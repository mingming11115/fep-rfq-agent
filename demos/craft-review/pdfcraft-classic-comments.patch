+/// Hash only bounded inline content, never recursively resolving references or decoding streams.
+/// FNV-1a is deterministic across processes; type and length markers keep values unambiguous.
+fn comment_fingerprint(object: &pdfcraft_cos::Object) -> u64 {
+    struct Fingerprint {
+        hash: u64,
+        nodes: usize,
+        bytes: usize,
+    }
+    impl Fingerprint {
+        fn feed(&mut self, bytes: &[u8]) {
+            for byte in bytes {
+                self.hash = (self.hash ^ u64::from(*byte)).wrapping_mul(0x100000001b3);
+            }
+        }
+        fn blob(&mut self, bytes: &[u8]) {
+            self.feed(&(bytes.len() as u64).to_le_bytes());
+            let len = bytes.len().min(self.bytes);
+            for byte in bytes.iter().take(len) {
+                self.feed(&[*byte]);
+            }
+            self.bytes -= len;
+        }
+        fn dict(&mut self, dict: &pdfcraft_cos::Dict, depth: usize) {
+            self.feed(&(dict.len() as u64).to_le_bytes());
+            for (key, value) in dict.iter() {
+                if self.nodes == 0 || self.bytes == 0 {
+                    break;
+                }
+                self.blob(key);
+                self.object(value, depth + 1);
+            }
+        }
+        fn object(&mut self, object: &pdfcraft_cos::Object, depth: usize) {
+            use pdfcraft_cos::Object;
+            if depth >= 16 || self.nodes == 0 || self.bytes == 0 {
+                self.feed(b"!");
+                return;
+            }
+            self.nodes -= 1;
+            match object {
+                Object::Null => self.feed(b"0"),
+                Object::Bool(value) => self.feed(if *value { b"t" } else { b"f" }),
+                Object::Int(_) | Object::Real(_) => {
+                    self.feed(b"n");
+                    let mut number = Vec::new();
+                    pdfcraft_cos::serialize(object, &mut number);
+                    self.blob(&number);
+                }
+                Object::String(value) => {
+                    self.feed(b"s");
+                    self.blob(&value.bytes);
+                }
+                Object::Name(value) => {
+                    self.feed(b"/");
+                    self.blob(value);
+                }
+                Object::Ref(value) => {
+                    self.feed(b"r");
+                    self.feed(&value.num.to_le_bytes());
+                    self.feed(&value.generation.to_le_bytes());
+                }
+                Object::Array(values) => {
+                    self.feed(b"a");
+                    self.feed(&(values.len() as u64).to_le_bytes());
+                    for value in values.iter().take(self.nodes) {
+                        if self.nodes == 0 || self.bytes == 0 {
+                            break;
+                        }
+                        self.object(value, depth + 1);
+                    }
+                }
+                Object::Dict(value) => {
+                    self.feed(b"d");
+                    self.dict(value, depth);
+                }
+                Object::Stream(value) => {
+                    self.feed(b"S");
+                    self.dict(&value.dict, depth);
+                    self.blob(value.raw.as_ref());
+                }
+            }
+        }
+    }
+    let mut fingerprint = Fingerprint { hash: 0xcbf29ce484222325, nodes: 4096, bytes: 65_536 };
+    fingerprint.object(object, 0);
+    fingerprint.hash
+}
