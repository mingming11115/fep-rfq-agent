+    #[test]
+    fn host_pdf_comments_stage_and_save_in_native_document() {
+        let mut a = app();
+        let id = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+        command(&mut a, "draft", json!({"id":id,"text":"Saved from the shared cards"})).unwrap();
+        command(&mut a, "replyDraft", json!({"id":id,"text":"A threaded PDF reply"})).unwrap();
+        command(&mut a, "flush", json!({})).unwrap();
+        let source = a.views[0].id;
+        let bytes = a.session.save_bytes(source).unwrap();
+        let mut reopened = PdfCraftApp::new();
+        reopened.open_bytes("saved.pdf", None, bytes.to_vec()).unwrap();
+        let doc = reopened.session.get(reopened.views[0].id).unwrap();
+        let root = doc.info.annotations.iter().find(|c| c.is_comment()).unwrap();
+        assert_eq!(root.contents.as_deref(), Some("Saved from the shared cards"));
+        assert!(
+            doc.info.annotations.iter().any(|c| c.parent == Some((root.page, root.index)) && c.contents.as_deref() == Some("A threaded PDF reply"))
+        );
+    }
+    #[test]
+    fn host_pdf_cancelled_drafts_do_not_enter_native_pdf() {
+        let mut a = app();
+        let id = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+        for action in ["draft", "replyDraft"] {
+            command(&mut a, action, json!({"id":id,"text":"Discard this"})).unwrap();
+        }
+        for action in ["cancelEdit", "cancelReply", "flush"] {
+            command(&mut a, action, json!({"id":id})).unwrap();
+        }
+        let notes = a.host_review_snapshot(&egui::Context::default(), 0)["notes"].as_array().unwrap().clone();
+        assert_eq!(notes.len(), 1);
+        assert_eq!(notes[0]["text"], "");
+        assert_eq!(notes[0]["replies"].as_array().unwrap().len(), 0);
+    }
+    #[test]
+    fn host_pdf_deletion_keeps_later_card_identity() {
+        let mut a = app();
+        let first = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+        let second = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+        command(&mut a, "delete", json!({"id":first})).unwrap();
+        command(&mut a, "draft", json!({"id":second,"text":"The surviving annotation"})).unwrap();
+        command(&mut a, "flush", json!({})).unwrap();
+        let snap = a.host_review_snapshot(&egui::Context::default(), 0);
+        assert_eq!(snap["notes"].as_array().unwrap().len(), 1);
+        assert_eq!(snap["notes"][0]["id"], second);
+        assert_eq!(snap["notes"][0]["text"], "The surviving annotation");
+    }
+    #[test]
+    fn host_pdf_rejects_stale_documents_and_unsupported_actions() {
+        let mut a = app();
+        assert!(a.host_review_command("old-document", "new", &json!({})).is_err());
+        assert!(command(&mut a, "file.delete", json!({})).is_err());
+        assert!(command(&mut a, "format", json!({})).is_err());
+        assert!(a.session.get(a.views[0].id).unwrap().info.annotations.is_empty());
+    }
+    #[test]
+    fn host_pdf_resolution_and_reopening_use_native_review_status() {
+        let mut a = app();
+        let id = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+        command(&mut a, "resolve", json!({"id":id})).unwrap();
+        assert_eq!(a.host_review_snapshot(&egui::Context::default(), 0)["notes"][0]["resolved"], true);
+        command(&mut a, "resolve", json!({"id":id})).unwrap();
+        assert_eq!(a.host_review_snapshot(&egui::Context::default(), 0)["notes"][0]["resolved"], false);
+    }
+    #[test]
+    fn host_pdf_drafts_survive_switching_native_tabs_and_flush_on_native_save() {
+        let mut a = app();
+        let first_doc = a.views[0].id;
+        let id = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+        command(&mut a, "draft", json!({"id":id,"text":"Draft in the first document"})).unwrap();
+        assert!(a.has_unsaved_work(0));
+        let bytes = a.session.create_blank(612.0, 792.0, 1).unwrap();
+        a.open_bytes("other.pdf", None, bytes.to_vec()).unwrap();
+        a.host_review_tick();
+        assert!(a.host_review_snapshot(&egui::Context::default(), 0)["notes"].as_array().unwrap().is_empty());
+        assert!(a.commit_typing_in(first_doc));
+        let native = a.session.get(first_doc).unwrap();
+        assert!(native.info.annotations.iter().any(|n| n.contents.as_deref() == Some("Draft in the first document")));
+    }
+    #[test]
+    fn host_pdf_refused_composer_retains_typed_text() {
+        let mut a = app();
+        a.views[0].comments.composer = Some(crate::comments::Composer {
+            page: 99,
+            at: [20.0, 20.0],
+            kind: crate::comments::ComposerKind::Note,
+            text: "Keep this failed draft".into(),
+            focus: true,
+        });
+        a.host_review_tick();
+        assert!(a.views[0].comments.composer.as_ref().is_some_and(|c| c.text == "Keep this failed draft"));
+        assert!(a.has_unsaved_work(0), "failed typed text must prevent a silent close");
+        let id = a.views[0].id;
+        assert!(!a.commit_typing_in(id), "saving must not silently omit a failed composer");
+    }
+    #[test]
+    fn host_pdf_navigation_reveals_the_anchor_in_a_rotated_view() {
+        let mut a = app();
+        let id = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+        for rotation in [90, 180] {
+            a.views[0].rotation = rotation;
+            command(&mut a, "select", json!({"id":id})).unwrap();
+            assert!(a.views[0].goto.unwrap().1 > 0.85, "top-right note should move near bottom at {rotation} degrees");
+        }
+        a.views[0].rotation = 270;
+        command(&mut a, "select", json!({"id":id})).unwrap();
+        assert!(a.views[0].goto.unwrap().1 < 0.12);
+    }
