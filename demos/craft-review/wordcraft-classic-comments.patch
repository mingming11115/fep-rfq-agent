+//! RFQ clause navigation and bidirectional comment writes; host metadata stays outside DOCX.
+use super::*;
+use std::collections::BTreeMap;
+
+#[derive(Default)]
+pub(crate) struct Project {
+    pub configured: bool,
+    pub document: u64,
+    pub editable: bool,
+    pub body: bool,
+    pub targets: Vec<Value>,
+    pub associations: BTreeMap<String, String>,
+    pub rules: BTreeMap<String, Value>,
+    pub matches: BTreeMap<String, Vec<(Pos, Pos)>>,
+    pub revision: Option<u64>,
+    pub selected: Option<String>,
+    pub status: String,
+    pub selection: Option<(Pos, Pos)>,
+}
+pub(super) fn key(id: u32) -> String {
+    format!("word-comment:{id}")
+}
+
+impl WordApp {
+    /// Projection of exactly the bytes handed to host_save, never a later live draft.
+    pub fn saved_host_review(name: &str, bytes: &[u8], document: &str, applied: u64) -> Option<Value> {
+        if document.is_empty() || bytes.len() > 50 * 1024 * 1024 {
+            return None;
+        }
+        let doc = wordcraft_engine::io::open_bytes(name, bytes).ok()?;
+        let threads = comment_threads(&doc.comments);
+        if threads.len() > 2000 || doc.comments.len() > 50_000 {
+            return None;
+        }
+        let notes:Vec<Value>=threads.into_iter().filter_map(|(id,replies)|{let c=doc.comments.get(&id)?;let replies:Vec<Value>=replies.into_iter().filter_map(|id|{let c=doc.comments.get(&id)?;Some(json!({"id":id,"nativeKey":key(id),"text":doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)),"author":c.author}))}).collect();Some(json!({"id":id,"nativeKey":key(id),"text":doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)),"author":c.author,"resolved":c.resolved,"replies":replies}))}).collect();
+        Some(json!({"document":document,"applied":applied,"notes":notes}))
+    }
+    pub fn set_host_review_permissions(&mut self, editable: bool, body: bool) {
+        let p = &mut self.comment_drafts.project;
+        p.configured = true;
+        p.editable = editable;
+        p.body = body;
+        self.sync_host_project();
+    }
+    pub(super) fn sync_host_project(&mut self) {
+        let document = self.session.document_id();
+        let p = &mut self.comment_drafts.project;
+        if !p.configured {
+            return;
+        }
+        if p.document != document {
+            p.document = document;
+            p.targets.clear();
+            p.associations.clear();
+            p.rules.clear();
+            p.matches.clear();
+            p.revision = None;
+            p.selected = None;
+            p.selection = None;
+            p.status = "unsupported".into();
+        }
+        let targets = p
+            .targets
+            .iter()
+            .filter_map(|t| Some((t.get("quote")?.as_str()?.to_string(), t.get("editable").and_then(Value::as_bool).unwrap_or(false))))
+            .collect();
+        let associations = p
+            .associations
+            .iter()
+            .filter_map(|(native, id)| {
+                let numeric = native.strip_prefix("word-comment:")?.parse::<u32>().ok()?;
+                let mut rule = p.rules.get(native).cloned().unwrap_or_else(|| json!({}));
+                rule["allowed"] = json!(p.targets.iter().any(
+                        |t| t.get("id").and_then(Value::as_str) == Some(id.as_str()) && t.get("editable").and_then(Value::as_bool) == Some(true)
+                    ));
+                Some((numeric, rule))
+            })
+            .collect();
+        self.session.set_host_review_access(p.editable, p.body, targets, associations);
+        if p.revision != Some(self.session.rev()) {
+            p.matches = p
+                .targets
+                .iter()
+                .filter_map(|t| {
+                    Some((t.get("id")?.as_str()?.to_string(), self.session.host_quote_matches(t.get("quote")?.as_str()?).unwrap_or_default()))
+                })
+                .collect();
+            p.revision = Some(self.session.rev());
+        }
+    }
+    pub(super) fn configure_host_project(&mut self, params: &Value) -> Result<Value, String> {
+        let targets = params.get("targets").and_then(Value::as_array).cloned().unwrap_or_default();
+        if targets.len() > 2000 {
+            return Err("too many clause targets".into());
+        }
+        let mut ids = std::collections::BTreeSet::new();
+        for t in &targets {
+            let id = t.get("id").and_then(Value::as_str).filter(|id| !id.is_empty() && id.len() <= 256).ok_or("invalid clause id")?;
+            if !ids.insert(id.to_string()) {
+                return Err("duplicate clause id".into());
+            }
+            if t.get("quote").and_then(Value::as_str).unwrap_or("").len() > 1_048_576 {
+                return Err("clause quote is too long".into());
+            }
+        }
+        if let Some(bindings) = params.get("associations").and_then(Value::as_array) {
+            if bindings.len() > 50_000 {
+                return Err("too many comment associations".into());
+            }
+            for b in bindings {
+                if let Some(clause) = b.get("clauseId").and_then(Value::as_str) {
+                    if !ids.contains(clause) {
+                        return Err("association refers to an unknown clause".into());
+                    }
+                }
+            }
+        }
+        self.set_host_review_permissions(
+            params.get("editable").and_then(Value::as_bool).unwrap_or(false),
+            params.get("editDocument").and_then(Value::as_bool).unwrap_or(false),
+        );
+        let p = &mut self.comment_drafts.project;
+        p.targets = targets;
+        p.revision = None;
+        if let Some(associations) = params.get("associations").and_then(Value::as_array) {
+            if associations.len() > 50_000 {
+                return Err("too many comment associations".into());
+            }
+            for a in associations {
+                if let (Some(native), Some(id)) = (a.get("nativeKey").and_then(Value::as_str), a.get("clauseId").and_then(Value::as_str)) {
+                    if !ids.contains(id) {
+                        return Err("association refers to an unknown clause".into());
+                    }
+                    p.associations.insert(native.to_string(), id.to_string());
+                    p.rules.insert(native.to_string(), a.clone());
+                }
+            }
+        }
+        self.sync_host_project();
+        if let Some(id) = params.get("selectedId").and_then(Value::as_str) {
+            return self.locate_host_clause(id);
+        }
+        Ok(json!({}))
+    }
+    pub(super) fn locate_host_clause(&mut self, id: &str) -> Result<Value, String> {
+        self.sync_host_project();
+        let target = self.comment_drafts.project.targets.iter().find(|t| t.get("id").and_then(Value::as_str) == Some(id)).ok_or("unknown clause")?;
+        let result = self.session.host_quote_matches(target.get("quote").and_then(Value::as_str).unwrap_or(""));
+        let status = match result {
+            Ok(matches) if matches.len() == 1 => {
+                if let Some((a, b)) = matches.first() {
+                    self.session.sel = wordcraft_engine::Selection { anchor: a.clone(), focus: b.clone() };
+                    self.canvas.scroll_to_caret = true;
+                    self.canvas.nav_to_caret = true;
+                }
+                "matched"
+            }
+            Ok(matches) if matches.is_empty() => "missing",
+            Ok(_) => "ambiguous",
+            Err(_) => "unsupported",
+        };
+        let p = &mut self.comment_drafts.project;
+        p.selected = Some(id.to_string());
+        p.status = status.into();
+        p.selection = Some(self.session.sel.ordered());
+        Ok(json!({"id":id,"status":status}))
+    }
+    pub(super) fn host_source_state(&mut self) -> Value {
+        self.sync_host_project();
+        let selection = self.session.sel.ordered();
+        let p = &self.comment_drafts.project;
+        if p.configured && p.selection.as_ref() != Some(&selection) {
+            let matches: Vec<String> = p
+                .matches
+                .iter()
+                .filter_map(|(id, found)| {
+                    let (a, b) = found.first()?;
+                    (found.len() == 1 && selection.0 >= *a && selection.1 <= *b).then(|| id.clone())
+                })
+                .collect();
+            let p = &mut self.comment_drafts.project;
+            if matches.len() == 1 {
+                p.selected = matches.first().cloned();
+                p.status = "matched".into();
+            }
+            p.selection = Some(selection);
+        }
+        let p = &self.comment_drafts.project;
+        json!({"selectedId":p.selected,"status":if p.status.is_empty(){"unsupported"}else{p.status.as_str()}})
+    }
+    pub(super) fn host_comment_quote(&self, id: u32) -> String {
+        let Some((a, b)) = self.session.host_comment_range(id) else { return String::new() };
+        let mut out = String::new();
+        for path in self.session.doc.para_paths(a.story) {
+            if let Some(para) = self.session.doc.para(a.story, &path) {
+                for (off, ch) in para.text.char_indices() {
+                    let pos = Pos { story: a.story, path: path.clone(), off };
+                    if pos >= a && pos < b && ch != wordcraft_doc::para::OBJ {
+                        out.push(ch);
+                    }
+                }
+                if !out.is_empty() {
+                    out.push(' ');
+                }
+            }
+        }
+        out.split_whitespace().collect::<Vec<_>>().join(" ")
+    }
+    pub(super) fn upsert_host_comment(&mut self, params: &Value) -> Result<Value, String> {
+        self.sync_host_project();
+        let clause = params.get("clauseId").and_then(Value::as_str).ok_or("a clause association is required")?.to_string();
+        let p = &self.comment_drafts.project;
+        if !p.configured
+            || !p.editable
+            || !p
+                .targets
+                .iter()
+                .any(|t| t.get("id").and_then(Value::as_str) == Some(clause.as_str()) && t.get("editable").and_then(Value::as_bool) == Some(true))
+        {
+            return Err("this clause is read only".into());
+        }
+        let text = params.get("text").and_then(Value::as_str).ok_or("missing comment text")?.to_string();
+        if text.len() > 1_048_576 {
+            return Err("comment is too long".into());
+        }
+        let replies = params.get("replies").and_then(Value::as_array).cloned().unwrap_or_default();
+        if replies.len() > 1000 {
+            return Err("too many replies".into());
+        }
+        let existing = if params.get("id").is_some_and(|v| !v.is_null()) { Some(super::id_of(params)?) } else { None };
+        if let Some(id) = existing {
+            let c = self.session.doc.comments.get(&id).ok_or("comment no longer exists")?;
+            if c.parent.is_some() {
+                return Err("upsert requires a root comment".into());
+            }
+            if c.author != self.session.author && self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)) != text {
+                return Err("only the comment author may edit it".into());
+            }
+        }
+        let anchor = if existing.is_none() {
+            let quote = params.get("quote").and_then(Value::as_str).unwrap_or("");
+            let found = self.session.host_quote_matches(quote)?;
+            match found.len() {
+                0 => return Err("quote missing from source".into()),
+                1 => found.first().cloned(),
+                _ => return Err("quote is ambiguous in source".into()),
+            }
+        } else {
+            None
+        };
+        if let Some((a, b)) = &anchor {
+            let target = self
+                .comment_drafts
+                .project
+                .targets
+                .iter()
+                .find(|t| t.get("id").and_then(Value::as_str) == Some(clause.as_str()))
+                .ok_or("unknown clause")?;
+            let found = self.session.host_quote_matches(target.get("quote").and_then(Value::as_str).unwrap_or(""))?;
+            if found.len() != 1 {
+                return Err(if found.is_empty() { "clause quote missing from source" } else { "clause quote is ambiguous" }.into());
+            }
+            if !found.first().is_some_and(|(start, end)| a >= start && b <= end) {
+                return Err("quote is outside the associated clause".into());
+            }
+        }
+        for reply in &replies {
+            if reply.get("text").and_then(Value::as_str).unwrap_or("").len() > 1_048_576 {
+                return Err("reply is too long".into());
+            }
+            if let Some(id) = reply.get("id").and_then(Value::as_u64) {
+                let id = u32::try_from(id).map_err(|_| "invalid reply id")?;
+                let c = self.session.doc.comments.get(&id).ok_or("reply no longer exists")?;
+                if c.parent != existing {
+                    return Err("reply belongs to another thread".into());
+                }
+                if c.author != self.session.author
+                    && self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)) != reply.get("text").and_then(Value::as_str).unwrap_or("")
+                {
+                    return Err("only the reply author may edit it".into());
+                }
+            }
+        }
+        let snap = self.session.edit_snapshot();
+        let author = self.session.author.clone();
+        let associations = self.comment_drafts.project.associations.clone();
+        let result = (|| {
+            let id = if let Some(id) = existing {
+                id
+            } else {
+                if let Some((a, b)) = anchor {
+                    self.session.sel = wordcraft_engine::Selection { anchor: a, focus: b };
+                }
+                self.session.author =
+                    params.get("author").and_then(Value::as_str).filter(|s| !s.trim().is_empty()).unwrap_or(&author).chars().take(200).collect();
+                let result = self.run("review.newComment", json!({"text":text}))?;
+                super::id_of(&result)?
+            };
+            self.comment_drafts.project.associations.insert(key(id), clause.clone());
+            self.sync_host_project();
+            if existing.is_some()
+                && self.session.doc.comments.get(&id).is_some_and(|c| self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)) != text)
+            {
+                self.run("review.editComment", json!({"id":id,"text":text}))?;
+            }
+            let root_author = self.session.author.clone();
+            let mut output = Vec::new();
+            for r in replies {
+                let text = r.get("text").and_then(Value::as_str).unwrap_or("");
+                let by = r.get("author").and_then(Value::as_str).filter(|s| !s.trim().is_empty()).unwrap_or(&author);
+                let old = r.get("id").and_then(Value::as_u64).and_then(|n| u32::try_from(n).ok()).or_else(|| {
+                    self.session
+                        .doc
+                        .comments
+                        .iter()
+                        .find(|(_, c)| {
+                            c.parent == Some(id) && c.author == by && self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)) == text
+                        })
+                        .map(|(id, _)| *id)
+                });
+                let rid = if let Some(rid) = old {
+                    let c = self.session.doc.comments.get(&rid).ok_or("reply missing")?;
+                    if self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)) != text {
+                        self.session.author = author.clone();
+                        self.run("review.editComment", json!({"id":rid,"text":text}))?;
+                    }
+                    rid
+                } else {
+                    self.session.author = by.chars().take(200).collect();
+                    let r = self.run("review.reply", json!({"id":id,"text":text}))?;
+                    super::id_of(&r)?
+                };
+                output.push(json!({"id":rid,"nativeKey":key(rid)}));
+            }
+            self.session.author = root_author;
+            self.sync_host_project();
+            self.run("review.resolveComment", json!({"id":id,"value":params.get("resolved").and_then(Value::as_bool).unwrap_or(false)}))?;
+            self.session.view.comments_pane = false;
+            Ok(json!({"id":id,"nativeKey":key(id),"replies":output}))
+        })();
+        self.session.author = author;
+        if result.is_err() {
+            self.session.restore(snap);
+            self.comment_drafts.project.associations = associations;
+        }
+        self.sync_host_project();
+        result
+    }
+}
