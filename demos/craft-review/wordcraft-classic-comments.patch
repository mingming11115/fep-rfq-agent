+use super::*;
+
+fn app(text: &str) -> WordApp {
+    let mut app = WordApp::new(wordcraft_engine::Session::new(wordcraft_doc::Document::new()), Default::default());
+    app.run("text.insert", json!({"text":text})).unwrap();
+    app.session.author = "Reviewer".into();
+    app.enable_host_review();
+    app
+}
+fn command(app: &mut WordApp, action: &str, params: Value) -> Result<Value, String> {
+    app.host_review_action(&json!({"document":app.session.document_id().to_string(),"action":action,"params":params}))
+}
+fn configure(app: &mut WordApp, editable: bool) {
+    command(app,"configure",json!({"editable":editable,"editDocument":false,"targets":[{"id":"c1","quote":"Unique clause","editable":true},{"id":"c2","quote":"Repeated","editable":false}],"selectedId":"c1"})).unwrap();
+}
+#[test]
+fn project_word_locate_unique_ambiguous_missing_and_native_selection() {
+    let mut a = app("Unique clause Repeated Repeated");
+    configure(&mut a, true);
+    assert_eq!(command(&mut a, "locate", json!({"id":"c1"})).unwrap()["status"], "matched");
+    assert_eq!(a.host_review_snapshot(1.0)["source"]["selectedId"], "c1");
+    assert_eq!(command(&mut a, "locate", json!({"id":"c2"})).unwrap()["status"], "ambiguous");
+    command(&mut a,"configure",json!({"editable":true,"editDocument":false,"targets":[{"id":"c1","quote":"Unique clause","editable":true},{"id":"missing","quote":"Absent","editable":true}]})).unwrap();
+    assert_eq!(command(&mut a, "locate", json!({"id":"missing"})).unwrap()["status"], "missing");
+    let mut at = a.session.doc.start_of(wordcraft_doc::StoryRef::Body);
+    at.off = 2;
+    a.session.sel = wordcraft_engine::Selection::caret(at);
+    assert_eq!(a.host_review_snapshot(1.0)["source"]["selectedId"], "c1");
+}
+#[test]
+fn project_word_upsert_roundtrip_keeps_author_replies_and_identity_without_duplicates() {
+    let mut a = app("Unique clause");
+    configure(&mut a, true);
+    let params = json!({"text":"Business comment","author":"Reviewer","resolved":true,"quote":"Unique clause","clauseId":"c1","replies":[{"text":"Imported reply","author":"Colleague"}]});
+    let first = command(&mut a, "upsert", params.clone()).unwrap();
+    let mut update = params.clone();
+    update["id"] = first["id"].clone();
+    update["replies"][0]["id"] = first["replies"][0]["id"].clone();
+    let second = command(&mut a, "upsert", update).unwrap();
+    assert_eq!(first, second);
+    assert_eq!(a.session.doc.comments.len(), 2);
+    let note = a.host_review_snapshot(1.0)["notes"][0].clone();
+    assert_eq!(note["clauseId"], "c1");
+    assert_eq!(note["quote"], "Unique clause");
+    assert_eq!(note["resolved"], true);
+    assert_eq!(note["replies"][0]["author"], "Colleague");
+    let path = std::env::temp_dir().join(format!("rfq-word-project-{}.docx", std::process::id()));
+    a.run("file.save", json!({"path":path.to_string_lossy()})).unwrap();
+    let reopened = wordcraft_engine::io::open_path(&path).unwrap();
+    let _ = std::fs::remove_file(path);
+    assert_eq!(reopened.comments.len(), 2);
+    assert!(reopened.comments.values().any(|c| c.author == "Reviewer" && c.resolved));
+    assert!(reopened.comments.values().any(|c| c.author == "Colleague" && c.parent.is_some()));
+}
+#[test]
+fn project_word_guards_native_keyboard_commands_and_does_not_export_fake_protection() {
+    let mut a = app("Unique clause Repeated Repeated");
+    configure(&mut a, true);
+    assert!(a.run("text.insert", json!({"text":"blocked"})).is_err());
+    assert!(command(&mut a, "upsert", json!({"text":"No anchor","author":"Reviewer","quote":"Repeated","clauseId":"c2","replies":[]})).is_err());
+    assert!(a.session.doc.comments.is_empty());
+    configure(&mut a, false);
+    assert!(a.run("review.newComment", json!({"text":"blocked"})).is_err());
+    assert!(command(&mut a, "new", json!({})).is_err());
+    assert!(a.session.doc.settings.protection.is_none());
+}
+
+#[test]
+fn project_word_foreign_text_is_readonly_but_authorized_reply_and_resolution_work() {
+    let mut a = app("Unique clause");
+    a.session.author = "Colleague".into();
+    let root = a.run("review.newComment", json!({"text":"Foreign text"})).unwrap()["id"].as_u64().unwrap();
+    a.session.author = "Reviewer".into();
+    configure(&mut a, true);
+    assert!(command(&mut a, "draft", json!({"id":root,"text":"Overwrite"})).is_err());
+    assert!(a.run("review.editComment", json!({"id":root,"text":"Overwrite"})).is_err());
+    let result=command(&mut a,"upsert",json!({"id":root,"text":"Foreign text","author":"Colleague","resolved":true,"clauseId":"c1","replies":[{"text":"Authorized reply","author":"Reviewer"}]})).unwrap();
+    assert_eq!(result["replies"].as_array().unwrap().len(), 1);
+    assert!(command(&mut a, "upsert", json!({"id":root,"text":"Overwrite","clauseId":"c1","replies":[]})).is_err());
+    command(&mut a,"configure",json!({"editable":true,"editDocument":false,"targets":[{"id":"c1","quote":"Unique clause","editable":true}],"associations":[{"nativeKey":result["nativeKey"],"clauseId":"c1","canReply":false,"canResolve":false}]})).unwrap();
+    assert!(a.run("review.reply", json!({"id":root,"text":"Denied"})).is_err());
+    assert!(a.run("review.resolveComment", json!({"id":root})).is_err());
+}
+#[test]
+fn project_word_saved_projection_uses_bytes_and_new_notes_do_not_inherit_selected_clause() {
+    let mut a = app("Unique clause");
+    configure(&mut a, true);
+    command(&mut a, "locate", json!({"id":"c1"})).unwrap();
+    let id = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+    assert!(a.host_review_snapshot(1.0)["notes"][0]["clauseId"].is_null());
+    command(&mut a, "draft", json!({"id":id,"text":"Serialized"})).unwrap();
+    command(&mut a, "flush", json!({})).unwrap();
+    let path = std::env::temp_dir().join(format!("rfq-word-projection-{}.docx", std::process::id()));
+    a.run("file.save", json!({"path":path.to_string_lossy()})).unwrap();
+    let bytes = std::fs::read(&path).unwrap();
+    let _ = std::fs::remove_file(path);
+    command(&mut a, "draft", json!({"id":id,"text":"Later typing"})).unwrap();
+    let projection = WordApp::saved_host_review("source.docx", &bytes, "saved-token", 41).unwrap();
+    assert_eq!(projection["document"], "saved-token");
+    assert_eq!(projection["applied"], 41);
+    assert_eq!(projection["notes"][0]["text"], "Serialized");
+    assert_eq!(projection["notes"][0]["nativeKey"], format!("word-comment:{id}"));
+}
+
+#[test]
+fn project_word_native_comments_must_stay_inside_an_authorized_source_range() {
+    let mut a = app("Unique clause outside");
+    configure(&mut a, true);
+    let (start, mut end) = a.session.sel.ordered();
+    end.off = "Unique clause outside".len();
+    a.session.sel = wordcraft_engine::Selection { anchor: start, focus: end };
+    assert!(a.run("review.newComment", json!({"text":"Crosses the authorized range"})).is_err());
+    command(&mut a, "locate", json!({"id":"c1"})).unwrap();
+    let id = command(&mut a, "new", json!({})).unwrap()["id"].as_u64().unwrap();
+    command(&mut a, "draft", json!({"id":id,"text":"Inside the authorized range"})).unwrap();
+    command(&mut a, "flush", json!({})).unwrap();
+    assert_eq!(a.host_review_snapshot(1.0)["notes"][0]["text"], "Inside the authorized range");
+}
