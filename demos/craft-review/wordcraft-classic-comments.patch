+/// Group all replies under their root, retaining orphans as visible standalone comments.
+/// A corrupt parent cycle or unreasonably deep chain never hangs the interface.
+fn comment_threads(comments: &BTreeMap<u32, wordcraft_doc::Comment>) -> Vec<(u32, Vec<u32>)> {
+    let mut threads: BTreeMap<u32, Vec<u32>> = BTreeMap::new();
+    for id in comments.keys().copied() {
+        let mut root = id;
+        let mut complete = false;
+        for _ in 0..64 {
+            match comments.get(&root).and_then(|comment| comment.parent).filter(|parent| comments.contains_key(parent)) {
+                Some(parent) if parent != root && parent != id => root = parent,
+                None => {
+                    complete = true;
+                    break;
                 }
-            });
-            ui.add_space(6.0);
-        }
-    });
+                _ => break,
+            }
+        }
+        if !complete {
+            root = id;
+        }
+        let replies = threads.entry(root).or_default();
+        if root != id {
+            replies.push(id);
+        }
+    }
+    threads.into_iter().collect()
+}
