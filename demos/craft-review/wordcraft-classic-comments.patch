+    pub fn drain_review(&self, app: &mut WordApp) {
+        let actions: Vec<_> = self.review_actions.borrow_mut().drain(..).collect();
+        for action in actions {
+            let result = app.host_review_action(&action);
+            if let Some(sequence) = action.get("request").and_then(serde_json::Value::as_u64) {
+                self.review_sequence.set(self.review_sequence.get().max(sequence));
+            }
+            let payload = match result {
+                Ok(value) => serde_json::json!({"request":action.get("request"),"ok":true,"result":value}),
+                Err(error) => serde_json::json!({"request":action.get("request"),"ok":false,"error":error}),
+            };
+            self.send(&[("type", "wordcraft:reviewResult".into()), ("payload", payload.to_string().into())]);
+        }
+    }
+
+    pub fn post_review(&self, payload: &str) {
+        self.send(&[("type", "wordcraft:reviewState".into()), ("payload", payload.into())]);
+    }
+
+    pub fn review_sequence(&self) -> u64 {
+        self.review_sequence.get()
+    }
