+#[cfg(test)]
+mod classic_comment_tests {
+    use super::*;
+
+    fn comment(parent: Option<u32>) -> wordcraft_doc::Comment {
+        wordcraft_doc::Comment { parent, ..Default::default() }
+    }
+
+    #[test]
+    fn replies_and_nested_replies_stay_in_one_card() {
+        let comments = BTreeMap::from([(2, comment(None)), (8, comment(Some(2))), (10, comment(Some(8))), (20, comment(None))]);
+        assert_eq!(comment_threads(&comments), vec![(2, vec![8, 10]), (20, vec![])]);
+    }
+
+    #[test]
+    fn missing_and_cyclic_parents_remain_visible() {
+        let comments = BTreeMap::from([(1, comment(Some(99))), (2, comment(Some(3))), (3, comment(Some(2)))]);
+        assert_eq!(comment_threads(&comments), vec![(1, vec![]), (2, vec![]), (3, vec![])]);
+    }
 }
 
