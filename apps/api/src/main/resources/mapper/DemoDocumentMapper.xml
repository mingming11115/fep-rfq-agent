<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.naura.rfq.mapper.DemoDocumentMapper">

    <select id="findContent" resultType="_byte[]">
        select content from rfq_demo_document where id=#{id} and octet_length(content)=#{size}
    </select>
</mapper>
