# Docker Compose 对宿主机开放的端口；容器内部固定使用 48081。
RFQ_HOST_PORT=48081

# Docker Compose 默认启用 prod profile。
SPRING_PROFILES_ACTIVE=prod

# 可选 JVM 参数，例如 -XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8
JAVA_TOOL_OPTIONS=

# 为 RFQ 独立文档服务生成至少32字符随机密钥；不要提交实际值。
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=http://127.0.0.1:8082
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_HOST_PORT=8082
# 可加载条款联动插件的前端 origin，逗号分隔；部署时改为真实站点。
ONLYOFFICE_FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 业务数据库（Docker 内须使用容器可达的 MySQL 主机地址）。
RFQ_DB_URL=jdbc:mysql://host.docker.internal:3306/rfq?useUnicode=true&characterEncoding=utf8&allowPublicKeyRetrieval=true&useSSL=false
RFQ_DB_USER=rfq_app
RFQ_DB_PASSWORD=

# JWT 至少 32 字符；请填写自己的密钥。未填时仅沿用 application.yml 的本地开发默认值。
RFQ_JWT_SECRET=

# 完整 Chat Completions 端点；兼容内网模型网关，无密钥服务可留空 API_KEY。
RFQ_LLM_ENABLED=false
RFQ_HISTORY_RULES_ENABLED=true
RFQ_LLM_URL=
RFQ_LLM_API_KEY=
RFQ_LLM_MODEL=
RFQ_LLM_LOG_PAYLOAD=false
RFQ_LLM_CONNECT_TIMEOUT=3s
RFQ_LLM_TIMEOUT=30s
RFQ_LLM_BATCH_CHARS=16000
RFQ_LLM_BATCH_BLOCKS=20
RFQ_MARKITDOWN_TIMEOUT=60s
RFQ_WORD_MARKDOWN_MAX_CHARS=0

# HTTP OCR 适配器，协议见 README；与模型独立开关、独立降级。
RFQ_OCR_ENABLED=false
RFQ_OCR_URL=
RFQ_OCR_API_KEY=
RFQ_OCR_CONNECT_TIMEOUT=3s
RFQ_OCR_TIMEOUT=30s
RFQ_OCR_MAX_IMAGES=100
RFQ_OCR_MAX_IMAGE_PIXELS=20000000
RFQ_OCR_MAX_IMAGE_BYTES=10485760

# 项目 PDF 可使用内网自托管的 MinerU 3.4.x /file_parse 接口。
RFQ_MINERU_ENABLED=false
RFQ_MINERU_URL=
RFQ_MINERU_API_KEY=
RFQ_MINERU_BACKEND=pipeline
RFQ_MINERU_CONNECT_TIMEOUT=3s
RFQ_MINERU_TIMEOUT=120s

# RFQ original storage: local|minio. Create a private bucket before enabling MinIO.
RFQ_STORAGE_TYPE=local
RFQ_MINIO_ENDPOINT=
RFQ_MINIO_BUCKET=rfq-files
RFQ_MINIO_ACCESS_KEY=
RFQ_MINIO_SECRET_KEY=
