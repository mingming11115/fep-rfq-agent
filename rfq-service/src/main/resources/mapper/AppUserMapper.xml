<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.naura.rfq.mapper.AppUserMapper">

    <sql id="columns">id, username, password_hash, display_name, email, status, system_admin, created_at</sql>

    <select id="findById" resultType="com.naura.rfq.domain.AppUser">
        select <include refid="columns"/>
        from app_user
        where id = #{id}
    </select>

    <select id="findByUsername" resultType="com.naura.rfq.domain.AppUser">
        select <include refid="columns"/>
        from app_user
        where username = #{username}
    </select>

    <select id="count" resultType="long">
        select count(*)
        from app_user
    </select>

    <insert id="insert">
        insert into app_user (id, username, password_hash, display_name, email, status, system_admin,
                              created_at)
        values (#{id}, #{username}, #{passwordHash}, #{displayName}, #{email}, #{status},
                #{systemAdmin}, #{createdAt})
    </insert>
</mapper>
