+//! RFQ clause navigation and bidirectional comment writes; host metadata stays outside DOCX.
+use super::*;
+use std::collections::{BTreeMap, BTreeSet};
+use wordcraft_doc::{Cell, Document, Path, StoryRef};
+
+#[derive(Default)]
+pub(crate) struct Project {
+    pub configured: bool,
+    pub document: u64,
+    pub editable: bool,
+    pub body: bool,
+    pub external_tools: bool,
+    pub tools_visible: bool,
+    pub targets: Vec<Value>,
+    pub associations: BTreeMap<String, String>,
+    pub rules: BTreeMap<String, Value>,
+    pub matches: BTreeMap<String, Vec<(Pos, Pos)>>,
+    pub revision: Option<u64>,
+    pub selected: Option<String>,
+    pub status: String,
+    pub selection: Option<(Pos, Pos)>,
+}
+pub(super) fn key(id: u32) -> String {
+    format!("word-comment:{id}")
+}
+
+fn cell_text(cell: &Cell) -> String {
+    let text = cell.blocks.iter().filter_map(|block| block.as_para())
+        .map(|para| para.text.as_str()).collect::<Vec<_>>().join(" ");
+    text.replace(wordcraft_doc::para::OBJ, "").split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+fn cell_range(path: &Path, row: usize, column: usize, cell: &Cell) -> Option<(Pos, Pos)> {
+    let mut paragraphs = cell.blocks.iter().enumerate()
+        .filter_map(|(index, block)| block.as_para().map(|para| (index, para)));
+    let first = paragraphs.next()?;
+    let last = paragraphs.next_back().unwrap_or(first);
+    let position = |index: usize, off| {
+        let mut path = path.clone();
+        path.0.extend([row as u32, column as u32, index as u32]);
+        Pos { story: StoryRef::Body, path, off }
+    };
+    Some((position(first.0, 0), position(last.0, last.1.text.len())))
+}
+
+fn table_field_matches(doc: &Document, item: &str, description: &str) -> Vec<(Pos, Pos)> {
+    let item = item.split_whitespace().collect::<Vec<_>>().join(" ");
+    if item.is_empty() {
+        return Vec::new();
+    }
+    let description = description.split_whitespace().collect::<Vec<_>>().join(" ");
+    let tables: BTreeSet<_> = doc.para_paths(StoryRef::Body).into_iter()
+        .filter_map(|path| path.cell().map(|(table, _, _)| table)).collect();
+    let mut item_matches = Vec::new();
+    let mut pair_matches = Vec::new();
+    for path in tables {
+        let Some(table) = doc.table(StoryRef::Body, &path) else { continue };
+        let Some(header) = table.rows.first() else { continue };
+        let headers: Vec<_> = header.cells.iter().map(|cell| cell_text(cell).to_lowercase().replace(' ', "")).collect();
+        let Some(item_col) = headers.iter().position(|h|
+            matches!(h.as_str(), "item" | "项目" | "项目名称" | "项目item" | "item项目")) else { continue };
+        let description_col = headers.iter().position(|h| matches!(h.as_str(),
+            "description" | "描述" | "描述description" | "description描述" | "要求描述" | "要求说明"));
+        for (row_index, row) in table.rows.iter().enumerate().skip(1) {
+            let Some(cell) = row.cells.get(item_col) else { continue };
+            if cell_text(cell) != item {
+                continue;
+            }
+            let Some(range) = cell_range(&path, row_index, item_col, cell) else { continue };
+            if !description.is_empty() && pair_matches.len() < 2 {
+                if let Some(col) = description_col {
+                    if let Some(cell) = row.cells.get(col).filter(|cell| cell_text(cell) == description) {
+                        if let Some(other) = cell_range(&path, row_index, col, cell) {
+                            pair_matches.push((range.0.clone().min(other.0), range.1.clone().max(other.1)));
+                        }
+                    }
+                }
+            }
+            if item_matches.len() < 2 {
+                item_matches.push(range);
+            }
+        }
+    }
+    if pair_matches.len() == 1 { pair_matches } else { item_matches }
+}
