+#[test]
+fn host_unified_directory_exposes_real_headings_and_navigates_readonly() {
+    let mut app = WordApp::new(Session::new(Document::from_text("Repeated\nBody\nRepeated")), crate::Services::default());
+    for (index, style) in [(0, "Heading 1"), (2, "Heading 2")] {
+        app.run("caret.set", json!({"pos":Pos { story:StoryRef::Body,path:Path::top(index),off:0 }})).unwrap();
+        app.run("styles.apply", json!({"style":style})).unwrap();
+    }
+    app.enable_host_review();
+    app.set_host_review_permissions(false, false);
+    app.session.dirty = false;
+    let before = serde_json::to_value(&app.session.doc).unwrap();
+    let revision = app.session.rev();
+    let history = app.session.undo_depth();
+    app.session.view.nav_pane = true;
+    command(&mut app, "configure", json!({"externalOutline":true})).unwrap();
+    let outline = app.host_review_snapshot(1.0)["headingOutline"].clone();
+    assert_eq!(outline["revision"], revision);
+    assert_eq!(outline["items"].as_array().unwrap().len(), 2);
+    assert_eq!(outline["items"][0]["text"], "Repeated");
+    assert_eq!(outline["items"][1]["text"], "Repeated");
+    assert_eq!(outline["items"][1]["index"], 1);
+    assert_eq!(outline["items"][1]["level"], 1);
+    command(&mut app, "heading", json!({"revision":revision,"index":1})).unwrap();
+    assert_eq!(app.session.sel.focus.path, Path::top(2));
+    assert!(app.canvas.nav_to_caret);
+    assert_eq!(serde_json::to_value(&app.session.doc).unwrap(), before);
+    assert_eq!(app.session.rev(), revision);
+    assert_eq!(app.session.undo_depth(), history);
+    assert!(!app.session.dirty);
+    assert!(!app.session.view.nav_pane, "the host directory must not open a second native panel");
+}
