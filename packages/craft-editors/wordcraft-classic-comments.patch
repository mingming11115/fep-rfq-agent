diff --git a/crates/engine/src/host_access.rs b/crates/engine/src/host_access.rs
new file mode 100644
--- /dev/null
+++ b/crates/engine/src/host_access.rs
@@ -0,0 +1,177 @@
+//! Ephemeral host permissions. These never become document protection or exported metadata.
+use crate::{CmdError, Session};
+use serde_json::Value;
+use std::collections::BTreeMap;
+use wordcraft_doc::{Pos, StoryRef};
+
+pub(crate) struct HostAccess {
+    document: u64,
+    editable: bool,
+    body: bool,
+    targets: Vec<(String, bool)>,
+    associations: BTreeMap<u32, Value>,
+}
+
+impl Session {
+    pub fn set_host_review_access(&mut self, editable: bool, body: bool, targets: Vec<(String, bool)>, associations: BTreeMap<u32, Value>) {
+        self.host_access = Some(HostAccess { document: self.document_id(), editable, body, targets, associations });
+    }
+
+    /// Literal quote search with whitespace folded and inline anchor markers ignored. At most
+    /// two results are needed: ambiguity must never silently select the first occurrence.
+    pub fn host_quote_matches(&self, quote: &str) -> Result<Vec<(Pos, Pos)>, String> {
+        let needle = quote.split_whitespace().collect::<Vec<_>>().join(" ");
+        if needle.is_empty() || needle.len() > 1_048_576 {
+            return Err("quote is empty or too long".into());
+        }
+        let mut text = String::new();
+        let mut map: Vec<(usize, Pos, Pos)> = Vec::new();
+        for path in self.doc.para_paths(StoryRef::Body) {
+            let Some(para) = self.doc.para(StoryRef::Body, &path) else { continue };
+            for (off, ch) in para.text.char_indices() {
+                if ch == wordcraft_doc::para::OBJ {
+                    continue;
+                }
+                if map.len() >= 500_000 {
+                    return Err("source text exceeds the bounded quote search".into());
+                }
+                let a = Pos { story: StoryRef::Body, path: path.clone(), off };
+                let b = Pos { off: off + ch.len_utf8(), ..a.clone() };
+                let ch = if ch.is_whitespace() { ' ' } else { ch };
+                if ch == ' ' && text.ends_with(' ') {
+                    if let Some(last) = map.last_mut() {
+                        last.2 = b;
+                    }
+                    continue;
+                }
+                map.push((text.len(), a, b));
+                text.push(ch);
+            }
+            if !text.ends_with(' ') {
+                let pos = Pos { story: StoryRef::Body, path, off: para.text.len() };
+                map.push((text.len(), pos.clone(), pos));
+                text.push(' ');
+            }
+        }
+        let mut matches = Vec::new();
+        for (start, _) in text.match_indices(&needle).take(2) {
+            let end = start.saturating_add(needle.len());
+            let first = map.binary_search_by_key(&start, |(at, _, _)| *at).ok().and_then(|i| map.get(i));
+            let last = map.iter().rev().find(|(at, _, _)| *at < end);
+            if let (Some((_, a, _)), Some((_, _, b))) = (first, last) {
+                matches.push((a.clone(), b.clone()));
+            }
+        }
+        Ok(matches)
+    }
+
+    pub fn host_comment_range(&self, id: u32) -> Option<(Pos, Pos)> {
+        let mut start = None;
+        let mut end = None;
+        for path in self.doc.para_paths(StoryRef::Body) {
+            let Some(para) = self.doc.para(StoryRef::Body, &path) else { continue };
+            for off in para.object_offsets() {
+                let pos = Pos { story: StoryRef::Body, path: path.clone(), off };
+                match para.object_at(off) {
+                    Some(wordcraft_doc::para::InlineObject::CommentStart { id: n }) if *n == id => start = Some(pos),
+                    Some(wordcraft_doc::para::InlineObject::CommentEnd { id: n }) if *n == id => end = Some(pos),
+                    _ => {}
+                }
+            }
+        }
+        start.map(|mut a| {
+            let b = end.unwrap_or_else(|| a.clone());
+            if a.story == b.story && a.path == b.path && b.off == a.off.saturating_add(wordcraft_doc::para::OBJ.len_utf8()) {
+                return (a.clone(), a);
+            }
+            a.off = a.off.saturating_add(wordcraft_doc::para::OBJ.len_utf8());
+            (a, b)
+        })
+    }
+
+    fn host_range_allowed(&self, access: &HostAccess, range: &(Pos, Pos)) -> bool {
+        let mut matched = false;
+        for (quote, editable) in &access.targets {
+            let Ok(found) = self.host_quote_matches(quote) else { continue };
+            if found.len() != 1 {
+                continue;
+            }
+            if let Some((a, b)) = found.first() {
+                if range.0 <= *b && range.1 >= *a {
+                    if !editable {
+                        return false;
+                    }
+                    matched |= range.0 >= *a && range.1 <= *b;
+                }
+            }
+        }
+        matched || access.body
+    }
+
+    pub fn check_host_review_command(&self, id: &str, params: &Value) -> Result<(), CmdError> {
+        self.host_command_check(id, params)
+    }
+
+    pub(crate) fn host_command_check(&self, id: &str, params: &Value) -> Result<(), CmdError> {
+        let Some(access) = &self.host_access else { return Ok(()) };
+        if matches!(id, "file.open" | "file.new" | "file.save" | "file.saveAs") || id.starts_with("file.export") {
+            return Ok(());
+        }
+        let denied = || CmdError::Disabled("the host does not permit this document or comment change".into());
+        if access.document != self.document_id() {
+            return Err(denied());
+        }
+        let comment = matches!(id, "review.newComment" | "review.editComment" | "review.reply" | "review.resolveComment" | "review.deleteComment");
+        if !comment {
+            return if access.body { Ok(()) } else { Err(denied()) };
+        }
+        if !access.editable {
+            return Err(denied());
+        }
+        if id == "review.newComment" {
+            let (a, b) = self.sel.ordered();
+            return if self.host_range_allowed(access, &(a, b)) { Ok(()) } else { Err(denied()) };
+        }
+        if params.get("all").and_then(Value::as_bool) == Some(true) {
+            return Err(denied());
+        }
+        let numeric = params
+            .get("id")
+            .and_then(Value::as_u64)
+            .and_then(|id| u32::try_from(id).ok())
+            .or_else(|| crate::cmd::review::comment_range_at_caret(self))
+            .ok_or_else(denied)?;
+        let item = self.doc.comments.get(&numeric).ok_or_else(denied)?;
+        if matches!(id, "review.editComment" | "review.deleteComment") && item.author != self.author {
+            return Err(denied());
+        }
+        let mut root = numeric;
+        for _ in 0..64 {
+            match self.doc.comments.get(&root).and_then(|c| c.parent) {
+                Some(parent) if parent != root => root = parent,
+                _ => break,
+            }
+        }
+        let permission = match id {
+            "review.reply" => "canReply",
+            "review.resolveComment" => "canResolve",
+            "review.deleteComment" => "canDelete",
+            _ if numeric != root => "canReply",
+            _ => "canEdit",
+        };
+        let allowed = access
+            .associations
+            .get(&root)
+            .map(|rule| rule.get("allowed").and_then(Value::as_bool) == Some(true) && rule.get(permission).and_then(Value::as_bool).unwrap_or(true))
+            .unwrap_or_else(|| self.host_comment_range(root).is_some_and(|range| self.host_range_allowed(access, &range)));
+        if allowed { Ok(()) } else { Err(denied()) }
+    }
+
+    pub fn host_review_editable(&self) -> bool {
+        self.host_access.as_ref().is_none_or(|a| a.document == self.document_id() && a.editable)
+    }
+
+    pub(crate) fn host_history_allowed(&self) -> bool {
+        self.host_access.as_ref().is_none_or(|a| a.document == self.document_id() && a.body)
+    }
+}
