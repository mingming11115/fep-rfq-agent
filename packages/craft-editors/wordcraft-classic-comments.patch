+use super::*;
+use egui_kittest::kittest::Queryable;
+use wordcraft_doc::Document;
+use wordcraft_engine::Session;
+
+#[test]
+fn host_title_row_takes_no_space_while_standalone_keeps_its_controls() {
+    for hosted in [false, true] {
+        let mut app = WordApp::new(Session::new(Document::from_text("Original text")), crate::Services::default());
+        if hosted {
+            app.enable_host_review();
+        }
+        // Older preferences cannot restore any part of the hosted title row.
+        app.ui.show_discord = true;
+        app.ui.quick_access_toolbar = true;
+        let mut h = egui_kittest::Harness::builder()
+            .with_size(vec2(1600.0, 400.0))
+            .with_context_setup(|ctx| ctx.set_fonts(crate::theme::font_definitions(false, false)))
+            .build_ui_state(
+                move |ui, app| {
+                    let before = ui.available_rect_before_wrap();
+                    title_bar(app, ui);
+                    let after = ui.available_rect_before_wrap();
+                    if hosted {
+                        assert_eq!(before, after, "the removed row must not leave a blank band");
+                    } else {
+                        assert!(after.top() > before.top());
+                    }
+                },
+                app,
+            );
+        h.run_steps(3);
+        for label in ["Account", "Search commands and help"] {
+            assert_eq!(h.query_by_label(tl!(label)).is_some(), !hosted, "{label}");
+        }
+    }
+}
+
+#[test]
+fn host_without_title_row_keeps_ribbon_and_original_document() {
+    let mut app = WordApp::new(Session::new(Document::from_text("Original text")), crate::Services::default());
+    app.enable_host_review();
+    app.set_host_review_permissions(false, false);
+    app.session.dirty = false;
+    let before = serde_json::to_value(&app.session.doc).unwrap();
+    let revision = app.session.rev();
+    let mut h = egui_kittest::Harness::builder().with_size(vec2(1440.0, 900.0)).build_ui_state(
+        |ui, app: &mut WordApp| {
+            let ctx = ui.ctx().clone();
+            app.logic(&ctx);
+            app.ui(ui);
+        },
+        app,
+    );
+    h.run_steps(4);
+    for label in ["Account", "Search commands and help"] {
+        assert!(h.query_by_label(tl!(label)).is_none(), "{label} must be absent from the full host");
+    }
+    for tab in ["Home", "Insert", "Draw", "Review", "View", "Help"] {
+        assert!(h.query_by_label(tl!(tab)).is_some(), "{tab} remains available");
+    }
+    h.get_by_label(tl!("Home")).click();
+    h.run_steps(2);
+    assert!(!h.state().ui.ribbon_collapsed);
+    assert_eq!(serde_json::to_value(&h.state().session.doc).unwrap(), before);
+    assert_eq!(h.state().session.rev(), revision);
+    assert!(!h.state().session.dirty);
+}
