+//! Native data and commands for the host's existing Word-style comment surface.
+use super::{Value, WordApp, comment_threads, commit_reply, drafts, flush_comment_drafts, json};
+use std::collections::BTreeMap;
+use wordcraft_doc::{Pos, para::InlineObject};
+#[path = "host_project.rs"]
+pub(super) mod project;
+
+#[cfg(test)]
+#[path = "host_project_tests.rs"]
+mod project_tests;
+
+fn id_of(value: &Value) -> Result<u32, String> {
+    value.get("id").and_then(Value::as_u64).and_then(|v| u32::try_from(v).ok()).ok_or_else(|| "invalid comment id".into())
+}
+
+impl WordApp {
+    /// Host view state only; opening the tools must not change document access or content.
+    pub fn set_host_editor_tools(&mut self, visible: bool) {
+        self.comment_drafts.project.external_tools = true;
+        self.comment_drafts.project.tools_visible = visible;
+        if visible {
+            self.ui.ribbon_collapsed = false;
+        }
+    }
+    pub fn enable_host_review(&mut self) {
+        if !self.canvas.host_comments {
+            let _ = self.session.run("view.webLayout", &json!({}));
+            let _ = self.session.run("view.zoom", &json!({"value":"pageWidth"}));
+            self.ui.mini_toolbar = false;
+            // Apply the hosted default once; later frames preserve a user's expansion.
+            self.ui.ribbon_collapsed = true;
+        }
+        self.canvas.host_comments = true;
+        self.session.view.comments_pane = false;
+        self.session.view.show_markup = true;
+        self.session.prefs.markup.comments = true;
+        self.session.prefs.markup.comment_display = wordcraft_layout::display::CommentDisplay::Margin;
+    }
+    /// Only comment operations are accepted; document generations prevent delayed edits crossing files.
+    pub fn host_review_action(&mut self, message: &Value) -> Result<Value, String> {
+        if message.get("document").and_then(Value::as_str) != Some(self.session.document_id().to_string().as_str()) {
+            return Err("the document has changed".into());
+        }
+        let action = message.get("action").and_then(Value::as_str).unwrap_or("");
+        let p = message.get("params").cloned().unwrap_or_else(|| json!({}));
+        self.sync_host_project();
+        match action {
+            "configure" => self.configure_host_project(&p),
+            "tools" => {
+                let visible = p.get("visible").and_then(Value::as_bool).ok_or("missing tools visibility")?;
+                if !self.canvas.host_comments || !self.comment_drafts.project.external_tools {
+                    return Err("the host tools are not configured".into());
+                }
+                self.set_host_editor_tools(visible);
+                Ok(json!({"visible":visible}))
+            }
+            "locate" => self.locate_host_clause(p.get("id").and_then(Value::as_str).ok_or("missing clause id")?),
+            "outline" => {
+                let visible = p.get("visible").and_then(Value::as_bool).ok_or("missing outline visibility")?;
+                self.session.run("view.navigationPane", &json!({"value":visible})).map_err(|e| e.to_string())?;
+                self.ui.nav_tab = "headings".into();
+                Ok(json!({"visible":visible}))
+            }
+            "heading" => {
+                if p.get("revision").and_then(Value::as_u64) != Some(self.session.rev()) {
+                    return Err("the document headings have changed".into());
+                }
+                let index = p.get("index").and_then(Value::as_u64).and_then(|n| usize::try_from(n).ok()).ok_or("invalid heading index")?;
+                let (path, _, _) = super::super::nav::nav_headings(&self.session.doc).into_iter().nth(index).ok_or("no such document heading")?;
+                self.run("caret.set", json!({"pos":Pos { story:wordcraft_doc::StoryRef::Body,path,off:0 }}))?;
+                self.canvas.nav_to_caret = true;
+                self.canvas.scroll_to_caret = false;
+                self.canvas.want_focus = true;
+                Ok(json!({"index":index}))
+            }
+            "upsert" => self.upsert_host_comment(&p),
+            "draft" | "replyDraft" => {
+                let id = id_of(&p)?;
+                if !self.session.doc.comments.contains_key(&id) {
+                    return Err("no such comment".into());
+                }
+                let command = if action == "draft" { "review.editComment" } else { "review.reply" };
+                if !crate::widgets::enabled(self, command) {
+                    return Err("the document is protected".into());
+                }
+                self.session.check_host_review_command(command, &p).map_err(|e| e.to_string())?;
+                let text = p.get("text").and_then(Value::as_str).ok_or("missing text")?;
+                if text.len() > 1_048_576 {
+                    return Err("comment is too long".into());
+                }
+                if action == "draft" {
+                    drafts(self).edits.insert(id, text.to_string());
+                } else {
+                    drafts(self).replies.insert(id, text.to_string());
+                }
+                Ok(json!({}))
+            }
+            "cancelReply" => {
+                let id = id_of(&p)?;
+                drafts(self).replies.remove(&id);
+                Ok(json!({}))
+            }
+            "cancelEdit" => {
+                let id = id_of(&p)?;
+                drafts(self).edits.remove(&id);
+                Ok(json!({}))
+            }
+            "flush" => {
+                flush_comment_drafts(self)?;
+                Ok(json!({}))
+            }
+            "reply" => {
+                let id = id_of(&p)?;
+                commit_reply(self, id)?;
+                Ok(json!({}))
+            }
+            "select" => {
+                let id = id_of(&p)?;
+                let position =
+                    wordcraft_engine::cmd::review::comment_list(&self.session).into_iter().find(|(cid, _)| *cid == id).and_then(|(_, pos)| pos);
+                if let Some(position) = position {
+                    self.session.sel = wordcraft_engine::Selection::caret(position);
+                    self.canvas.scroll_to_caret = true;
+                    self.canvas.nav_to_caret = true;
+                }
+                Ok(json!({"id": id}))
+            }
+            "new" | "previous" | "next" | "resolve" | "delete" | "format" | "save" => {
+                flush_comment_drafts(self)?;
+                let command = match action {
+                    "new" => "review.newComment",
+                    "previous" => "review.previousComment",
+                    "next" => "review.nextComment",
+                    "resolve" => "review.resolveComment",
+                    "delete" => "review.deleteComment",
+                    "format" => "view.marks",
+                    _ => "file.save",
+                };
+                if action == "previous" || action == "next" {
+                    crate::canvas::deselect_balloon(self);
+                }
+                let result = self.run(command, p)?;
+                self.session.view.comments_pane = false;
+                Ok(result)
+            }
+            _ => Err("unsupported comment action".into()),
+        }
+    }
+
+    /// Coordinates are CSS pixels in the embedded editor, including scroll and interface zoom.
+    pub fn host_review_snapshot(&mut self, zoom: f32) -> Value {
+        let zoom = if zoom.is_finite() { zoom.clamp(0.25, 5.0) } else { 1.0 };
+        let source = self.host_source_state();
+        let headings: Vec<Value> = super::super::nav::nav_headings(&self.session.doc)
+            .into_iter()
+            .enumerate()
+            .map(|(index, (_, level, text))| json!({"index":index,"level":level,"text":text}))
+            .collect();
+        let layout = self.session.layout();
+        let mut starts: BTreeMap<u32, Pos> = BTreeMap::new();
+        let mut ends: BTreeMap<u32, Pos> = BTreeMap::new();
+        for story in self.session.doc.shown_stories() {
+            for path in self.session.doc.para_paths(story) {
+                let Some(p) = self.session.doc.para(story, &path) else { continue };
+                for off in p.object_offsets() {
+                    let pos = Pos { story, path: path.clone(), off };
+                    match p.object_at(off) {
+                        Some(InlineObject::CommentStart { id }) => {
+                            starts.insert(*id, pos);
+                        }
+                        Some(InlineObject::CommentEnd { id }) => {
+                            ends.insert(*id, pos);
+                        }
+                        _ => {}
+                    }
+                }
+            }
+        }
+        let document = self.session.document_id();
+        let active = self
+            .canvas
+            .balloon
+            .filter(|id| self.session.doc.comments.contains_key(id))
+            .or_else(|| wordcraft_engine::cmd::review::comment_range_at_caret(&self.session));
+        let rect = |r: egui::Rect| json!({"x":r.min.x*zoom,"y":r.min.y*zoom,"w":r.width()*zoom,"h":r.height()*zoom});
+        let pages: Vec<Value> = self
+            .canvas
+            .page_rects
+            .iter()
+            .enumerate()
+            .filter_map(|(index, r)| {
+                let page = layout.pages.get(index)?;
+                let scale = r.width() / page.w.max(1.0);
+                Some(json!({"page":index,"x":r.min.x*zoom,"y":r.min.y*zoom,"w":r.width()*zoom,"h":r.height()*zoom,"margin":216.0*scale*zoom}))
+            })
+            .collect();
+        let mut source_ranges = Vec::new();
+        let project = &self.comment_drafts.project;
+        if project.status == "matched" {
+            if let Some(found) = project.selected.as_ref().and_then(|id| project.matches.get(id)).filter(|found| found.len() == 1) {
+                if let Some((a, b)) = found.first() {
+                    for (index, range) in layout.selection_rects(&self.session.doc, a, b, self.session.page_hint) {
+                        if let (Some(screen), Some(page)) = (self.canvas.page_rects.get(index), layout.pages.get(index)) {
+                            let scale = screen.width() / page.w.max(1.0);
+                            source_ranges.push(json!({"page":index,"x":(screen.min.x+range.x*scale)*zoom,"y":(screen.min.y+range.y*scale)*zoom,"w":range.w*scale*zoom,"h":range.h*scale*zoom}));
+                        }
+                    }
+                }
+            }
+        }
+        let mut notes = Vec::new();
+        for (index, (id, replies)) in comment_threads(&self.session.doc.comments).into_iter().take(2000).enumerate() {
+            let Some(comment) = self.session.doc.comments.get(&id) else { continue };
+            let mut ranges = Vec::new();
+            if let Some(a) = starts.get(&id) {
+                let b = ends.get(&id).unwrap_or(a);
+                for (page_index, range) in layout.selection_rects(&self.session.doc, a, b, self.session.page_hint) {
+                    if let (Some(screen), Some(page)) = (self.canvas.page_rects.get(page_index), layout.pages.get(page_index)) {
+                        let scale = screen.width() / page.w.max(1.0);
+                        ranges.push(json!({"page":page_index,"x":(screen.min.x+range.x*scale)*zoom,"y":(screen.min.y+range.y*scale)*zoom,"w":range.w*scale*zoom,"h":range.h*scale*zoom}));
+                    }
+                }
+                if ranges.is_empty()
+                    && let Some(caret) = layout.caret_on(a, self.session.page_hint)
+                    && let (Some(screen), Some(page)) = (self.canvas.page_rects.get(caret.page), layout.pages.get(caret.page))
+                {
+                    let scale = screen.width() / page.w.max(1.0);
+                    ranges.push(json!({"page":caret.page,"x":(screen.min.x+caret.x*scale)*zoom,"y":(screen.min.y+caret.top*scale)*zoom,"w":2.0,"h":caret.height*scale*zoom}));
+                }
+            }
+            let text = if self.comment_drafts.document == document { self.comment_drafts.edits.get(&id).cloned() } else { None }
+                .unwrap_or_else(|| self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(comment.part)));
+            let replies: Vec<Value> = replies.iter().filter_map(|id| {
+                let c = self.session.doc.comments.get(id)?;
+                Some(json!({"id":id,"nativeKey":project::key(*id),"author":c.author,"text":self.session.doc.plain_text(wordcraft_doc::StoryRef::Part(c.part)),"resolved":c.resolved}))
+            }).collect();
+            notes.push(json!({"id":id,"nativeKey":project::key(id),"quote":self.host_comment_quote(id),"clauseId":self.comment_drafts.project.associations.get(&project::key(id)),"author":comment.author,"date":comment.date,"text":text,"resolved":comment.resolved,"color":index%3,"ranges":ranges,"replies":replies}));
+        }
+        json!({"fileName":self.session.path.as_ref().and_then(|p|p.file_name()).map(|n|n.to_string_lossy().to_string()).or_else(||self.session.file_name.clone()),"source":source,"complete":comment_threads(&self.session.doc.comments).len()<=2000,"document":document.to_string(),"author":self.session.author,"active":active,"notes":notes,"pages":pages,
+            "sourceRanges":source_ranges,"clip":self.canvas.canvas_rect.map(rect),"selection":self.canvas.mini_anchor.map(rect).filter(|_| !self.session.sel.is_collapsed()),
+            "editable":self.session.host_review_editable()&&crate::widgets::enabled(self,"review.editComment"),"formatting":self.session.view.marks,"outlineVisible":self.session.view.nav_pane,
+            "headingOutline":{"revision":self.session.rev(),"items":headings},
+            "editorToolsControlled":self.comment_drafts.project.external_tools,"editorToolsVisible":self.comment_drafts.project.external_tools&&self.comment_drafts.project.tools_visible})
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn app() -> (WordApp, u32) {
+        let mut a = WordApp::new(wordcraft_engine::Session::new(wordcraft_doc::Document::new()), Default::default());
+        a.run("text.insert", json!({"text":"Review this text"})).unwrap();
+        let id = a.run("review.newComment", json!({"text":"Original"})).unwrap()["id"].as_u64().unwrap() as u32;
+        (a, id)
+    }
+    fn message(app: &WordApp, action: &str, params: Value) -> Value {
+        json!({"document":app.session.document_id().to_string(),"action":action,"params":params})
+    }
+    #[test]
+    fn host_comment_drafts_flush_through_native_engine() {
+        let (mut a, id) = app();
+        let m = message(&a, "draft", json!({"id":id,"text":"Edited in the original UI"}));
+        a.host_review_action(&m).unwrap();
+        assert_eq!(a.host_review_snapshot(1.0)["notes"][0]["text"], "Edited in the original UI");
+        let m = message(&a, "flush", json!({}));
+        a.host_review_action(&m).unwrap();
+        assert_eq!(a.session.doc.plain_text(wordcraft_doc::StoryRef::Part(a.session.doc.comments[&id].part)), "Edited in the original UI");
+    }
+    #[test]
+    fn host_comment_cancelled_reply_does_not_enter_document() {
+        let (mut a, id) = app();
+        for (action, p) in [("replyDraft", json!({"id":id,"text":"Discard me"})), ("cancelReply", json!({"id":id})), ("flush", json!({}))] {
+            let m = message(&a, action, p);
+            a.host_review_action(&m).unwrap();
+        }
+        assert_eq!(a.session.doc.comments.len(), 1);
+    }
+    #[test]
+    fn host_comment_actions_reject_stale_documents_and_arbitrary_commands() {
+        let (mut a, id) = app();
+        let mut m = message(&a, "draft", json!({"id":id,"text":"Wrong file"}));
+        m["document"] = json!("old");
+        assert!(a.host_review_action(&m).is_err());
+        let m = message(&a, "text.insert", json!({"text":"no"}));
+        assert!(a.host_review_action(&m).is_err());
+    }
+    #[test]
+    fn host_comment_edits_and_replies_survive_native_save_and_reopen() {
+        let (mut a, id) = app();
+        for (action, params) in
+            [("draft", json!({"id":id,"text":"Saved from original cards"})), ("replyDraft", json!({"id":id,"text":"Native threaded reply"}))]
+        {
+            let m = message(&a, action, params);
+            a.host_review_action(&m).unwrap();
+        }
+        let path = std::env::temp_dir().join(format!("wordcraft-host-comments-{}.docx", std::process::id()));
+        a.run("file.save", json!({"path":path.to_string_lossy()})).unwrap();
+        let saved = wordcraft_engine::io::open_path(&path).unwrap();
+        let _ = std::fs::remove_file(path);
+        let root = saved.comments.get(&id).unwrap();
+        assert_eq!(saved.plain_text(wordcraft_doc::StoryRef::Part(root.part)), "Saved from original cards");
+        let reply = saved.comments.values().find(|c| c.parent == Some(id)).unwrap();
+        assert_eq!(saved.plain_text(wordcraft_doc::StoryRef::Part(reply.part)), "Native threaded reply");
+    }
+    #[test]
+    fn host_comment_anchor_coordinates_follow_the_native_page() {
+        let (mut a, _) = app();
+        let l = a.session.layout();
+        let page = &l.pages[0];
+        a.canvas.page_rects = vec![egui::Rect::from_min_size(egui::pos2(50.0, 200.0), egui::vec2(page.w, page.h))];
+        let first = a.host_review_snapshot(1.0)["notes"][0]["ranges"][0]["y"].as_f64().unwrap();
+        a.canvas.page_rects[0] = a.canvas.page_rects[0].translate(egui::vec2(0.0, -70.0));
+        let second = a.host_review_snapshot(1.0)["notes"][0]["ranges"][0]["y"].as_f64().unwrap();
+        assert!((first - second - 70.0).abs() < 0.01);
+    }
+}
