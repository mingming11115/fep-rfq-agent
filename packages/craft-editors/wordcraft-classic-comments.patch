+//! RFQ's shared toolbar policy must survive personal settings and ribbon overflow.
+use super::*;
+use egui_kittest::kittest::Queryable;
+use wordcraft_engine::Session;
+
+const REMOVED: [&str; 7] = ["Zotero", "Developer", "Mailings", "References", "Layout", "Design", "File"];
+
+#[test]
+fn rfq_host_editor_tools_startup_and_new_documents_default_to_hidden() {
+    let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("First file")), crate::Services::default());
+    app.enable_host_review();
+    app.set_host_review_permissions(false, false);
+    // The web constructor calls this before painting, after restoring old preferences.
+    app.ui.ribbon_collapsed = false;
+    app.set_host_editor_tools(false);
+    assert_eq!(app.host_review_snapshot(1.0)["editorToolsVisible"], false);
+    app.set_host_editor_tools(true);
+    assert_eq!(app.host_review_snapshot(1.0)["editorToolsVisible"], true);
+    let previous = app.session.document_id().to_string();
+    app.session = Session::new(wordcraft_doc::Document::from_text("Next file"));
+    assert_eq!(app.host_review_snapshot(1.0)["editorToolsVisible"], false);
+    assert!(app.host_review_action(&json!({"document":previous,"action":"tools","params":{"visible":true}})).is_err());
+    assert_eq!(app.session.doc.plain_text(wordcraft_doc::StoryRef::Body), "Next file");
+    assert!(!app.session.dirty);
+}
+
+#[test]
+fn rfq_host_editor_tools_toggle_is_view_only_and_has_no_hidden_space() {
+    fn command(app: &mut WordApp, action: &str, params: Value) -> Result<Value, String> {
+        app.host_review_action(&json!({"document":app.session.document_id().to_string(),"action":action,"params":params}))
+    }
+    for width in [340.0, 1600.0] {
+        let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("Original text")), crate::Services::default());
+        app.enable_host_review();
+        command(&mut app, "configure", json!({"editable":false,"editDocument":false,"externalTools":true})).unwrap();
+        app.session.dirty = false;
+        let before = serde_json::to_value(&app.session.doc).unwrap();
+        let revision = app.session.rev();
+        let history = app.session.undo_depth();
+        assert_eq!(app.host_review_snapshot(1.0)["editorToolsControlled"], true);
+        assert_eq!(app.host_review_snapshot(1.0)["editorToolsVisible"], false);
+        let mut h = egui_kittest::Harness::builder()
+            .with_size(vec2(width, 500.0))
+            .with_context_setup(|ctx| ctx.set_fonts(crate::theme::font_definitions(false, false)))
+            .build_ui_state(
+                |ui, app: &mut WordApp| {
+                    let before = ui.available_rect_before_wrap();
+                    show(app, ui);
+                    if app.host_review_snapshot(1.0)["editorToolsVisible"] == false {
+                        assert_eq!(ui.available_rect_before_wrap(), before, "a hidden ribbon reserves no space");
+                    }
+                },
+                app,
+            );
+        h.run_steps(3);
+        for tab in ["Home", "Insert", "Draw", "Review", "View", "Help", "Comments", "Share"] {
+            assert!(h.query_by_label(tl!(tab)).is_none(), "{tab} is absent by default");
+        }
+        command(h.state_mut(), "tools", json!({"visible":true})).unwrap();
+        h.run_steps(3);
+        assert_eq!(h.state_mut().host_review_snapshot(1.0)["editorToolsVisible"], true);
+        assert!(!h.state().ui.ribbon_collapsed, "the host toggle exposes the actual tools");
+        assert!(h.query_by_label(tl!("Home")).is_some());
+        for tab in REMOVED {
+            assert!(h.query_by_label(tl!(tab)).is_none(), "{tab} stays hidden");
+        }
+        command(h.state_mut(), "configure", json!({"editable":false,"editDocument":false,"externalTools":true})).unwrap();
+        assert_eq!(h.state_mut().host_review_snapshot(1.0)["editorToolsVisible"], true, "refresh keeps the explicit choice");
+        assert!(h.state_mut().run("text.insert", json!({"text":"blocked"})).is_err(), "showing tools grants no write permission");
+        assert!(command(h.state_mut(), "tools", json!({"visible":"invalid"})).is_err());
+        command(h.state_mut(), "tools", json!({"visible":false})).unwrap();
+        h.run_steps(2);
+        assert!(h.query_by_label(tl!("Home")).is_none());
+        assert_eq!(serde_json::to_value(&h.state().session.doc).unwrap(), before);
+        assert_eq!(h.state().session.rev(), revision);
+        assert_eq!(h.state().session.undo_depth(), history);
+        assert!(!h.state().session.dirty);
+    }
+}
