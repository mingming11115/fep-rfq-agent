+#[test]
+fn rfq_editing_mode_button_is_hidden_for_both_modes_and_narrow_windows() {
+    for hosted in [false, true] {
+        for track in [false, true] {
+            for width in [340.0, 1600.0] {
+                let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("Review this text")), crate::Services::default());
+                app.session.doc.settings.track_changes = track;
+                if hosted {
+                    app.enable_host_review();
+                }
+                app.ui.ribbon_collapsed = true;
+                let mut h = egui_kittest::Harness::builder()
+                    .with_size(vec2(width, 400.0))
+                    .with_context_setup(|ctx| ctx.set_fonts(crate::theme::font_definitions(false, false)))
+                    .build_ui_state(|ui, app| show(app, ui), app);
+                h.run_steps(3);
+                let label = if track { "Reviewing" } else { "Editing" };
+                assert_eq!(h.query_by_label(tl!(label)).is_some(), !hosted, "{label}, hosted={hosted}, width={width}");
+                for kept in ["Comments", "Share"] {
+                    assert!(h.query_by_label(tl!(kept)).is_some(), "{kept} remains available");
+                }
+                assert_eq!(h.state().session.doc.settings.track_changes, track);
+            }
+        }
+    }
+}
+
+#[test]
+fn rfq_toolbar_starts_collapsed_and_tab_click_expands_it() {
+    let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("Review this text")), crate::Services::default());
+    // The hosted default takes precedence over an older expanded browser preference.
+    app.ui.ribbon_collapsed = false;
+    app.enable_host_review();
+    let mut h = egui_kittest::Harness::builder()
+        .with_size(vec2(1600.0, 400.0))
+        .with_context_setup(|ctx| ctx.set_fonts(crate::theme::font_definitions(false, false)))
+        .build_ui_state(|ui, app| show(app, ui), app);
+    h.run_steps(3);
+    assert!(h.state().ui.ribbon_collapsed, "each new hosted editor starts collapsed");
+    h.get_by_label(tl!("Home")).click();
+    h.run_steps(2);
+    assert!(!h.state().ui.ribbon_collapsed, "clicking even the active tab expands its tools");
+    // The web shell enables host review every frame; it must preserve a manual expansion.
+    h.state_mut().enable_host_review();
+    h.run_steps(2);
+    assert!(!h.state().ui.ribbon_collapsed);
+    h.state_mut().run("ui.collapseRibbon", json!({})).unwrap();
+    h.run_steps(2);
+    assert!(h.state().ui.ribbon_collapsed, "the existing collapse command still works");
+    h.get_by_label(tl!("Insert")).click();
+    h.run_steps(2);
+    assert!(!h.state().ui.ribbon_collapsed);
+}
+
+#[test]
+fn rfq_hidden_tabs_stay_absent_after_reset_show_and_stale_selection() {
+    for selected in REMOVED {
+        let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("Review this text")), crate::Services::default());
+        app.enable_host_review();
+        app.session.ribbon.set_hidden("Zotero", true).unwrap();
+        app.session.ribbon.reset_ribbon();
+        for tab in REMOVED.into_iter().filter(|tab| *tab != "File") {
+            app.session.ribbon.set_hidden(tab, false).unwrap();
+        }
+        // An older browser's selected tab must fall back to a visible one.
+        app.ui.tab = selected.into();
+        let mut h = egui_kittest::Harness::builder()
+            .with_size(vec2(1600.0, 400.0))
+            .with_context_setup(|ctx| ctx.set_fonts(crate::theme::font_definitions(false, false)))
+            .build_ui_state(|ui, app| show(app, ui), app);
+        h.run_steps(3);
+        for tab in REMOVED {
+            assert!(h.query_by_label(tl!(tab)).is_none(), "{tab} is hidden after reset/show; selected {selected}");
+        }
+        for tab in ["Home", "Insert", "Draw", "Review", "View", "Help"] {
+            assert!(h.query_by_label(tl!(tab)).is_some(), "{tab} stays available");
+        }
+        assert_eq!(h.state().ui.tab, "Home");
+    }
+}
+
+#[test]
+fn rfq_more_tabs_menu_keeps_allowed_tabs_without_restoring_removed_ones() {
+    let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("Review this text")), crate::Services::default());
+    app.enable_host_review();
+    let mut h = egui_kittest::Harness::builder()
+        .with_size(vec2(340.0, 400.0))
+        .with_context_setup(|ctx| ctx.set_fonts(crate::theme::font_definitions(false, false)))
+        .build_ui_state(|ui, app| show(app, ui), app);
+    h.run_steps(3);
+    h.get_by_label(tl!("More tabs")).click();
+    h.run_steps(2);
+    for tab in REMOVED {
+        assert!(h.query_by_label(tl!(tab)).is_none(), "{tab} must not leak into the overflow menu");
+    }
+    h.get_by_label(tl!("Help")).click();
+    h.run_steps(2);
+    assert_eq!(h.state().ui.tab, "Help");
+    assert!(!h.state().ui.ribbon_collapsed, "a tab chosen from the overflow menu expands too");
+}
+
+#[test]
+fn rfq_keeps_table_context_tabs_and_custom_tabs_clickable() {
+    let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("Review this text")), crate::Services::default());
+    app.run("insert.table", json!({"rows": 2, "cols": 2})).unwrap();
+    app.session.ribbon.new_tab(Some("Team"), None).unwrap();
+    app.enable_host_review();
+    let mut h = egui_kittest::Harness::builder()
+        .with_size(vec2(1600.0, 400.0))
+        .with_context_setup(|ctx| ctx.set_fonts(crate::theme::font_definitions(false, false)))
+        .build_ui_state(|ui, app| show(app, ui), app);
+    h.run_steps(3);
+    for tab in ["Table Design", "Table Layout", "Team"] {
+        h.get_by_label(tl!(tab)).click();
+        h.run_steps(2);
+        assert_eq!(h.state().ui.tab, tab);
+    }
+}
