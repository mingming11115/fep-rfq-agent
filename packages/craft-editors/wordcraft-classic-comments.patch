+        "configure",
+        json!({"editable":false,"editDocument":false,"targets":[
+            {"id":"first","no":"S1","title":"Safety","quote":"First clause","editable":false},
+            {"id":"ambiguous","no":"F1","title":"Duplicate","quote":"Second clause","editable":false}
+        ]}),
+    )
+    .unwrap();
+    app.session.dirty = false;
+    let before = serde_json::to_value(&app.session.doc).unwrap();
