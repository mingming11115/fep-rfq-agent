+/// The directory is view data only. Never create heading styles or TOC fields in the file.
+fn directory_items(app: &WordApp) -> Vec<(Path, u8, String)> {
+    let headings = nav_headings(&app.session.doc);
+    if !headings.is_empty() || !app.canvas.host_comments {
+        return headings;
+    }
+    let project = &app.comment_drafts.project;
+    if project.document != app.session.document_id() || project.revision != Some(app.session.rev()) {
+        return Vec::new();
+    }
+    let mut items = Vec::new();
+    for target in &project.targets {
+        let Some(id) = target.get("id").and_then(serde_json::Value::as_str) else { continue };
+        let Some(matches) = project.matches.get(id) else { continue };
+        let [(start, _)] = matches.as_slice() else { continue };
+        let number = target.get("no").and_then(serde_json::Value::as_str).unwrap_or("");
+        let title = target
+            .get("title")
+            .and_then(serde_json::Value::as_str)
+            .filter(|s| !s.trim().is_empty())
+            .or_else(|| target.get("quote").and_then(serde_json::Value::as_str))
+            .unwrap_or("");
+        let label = format!("{number} {title}").trim().chars().take(160).collect::<String>();
+        items.push((start.path.clone(), 0, label));
+    }
+    items.sort_by(|a, b| a.0.cmp(&b.0));
+    items.dedup_by(|a, b| a.0 == b.0);
+    items
 }
 
