diff --git a/crates/ui-egui/src/host_review.rs b/crates/ui-egui/src/host_review.rs
new file mode 100644
--- /dev/null
+++ b/crates/ui-egui/src/host_review.rs
@@ -0,0 +1,617 @@
+//! Host review adapter; edits stay in the native PDF engine.
+use crate::PdfCraftApp;
+use pdfcraft_engine::{DocId, Edit, NewAnnotation, NoteIcon, ReviewState, Shape};
+use serde_json::{Value, json};
+use std::collections::{BTreeMap, HashMap, HashSet};
+#[path = "host_project.rs"]
+mod project;
+
+#[cfg(test)]
+#[path = "host_project_tests.rs"]
+mod project_tests;
+
+#[derive(Default)]
+pub(crate) struct HostReview {
+    documents: HashMap<DocId, ReviewDocument>,
+    serial: u64,
+    initial: Option<(bool, bool)>,
+    pub clip: Option<egui::Rect>,
+}
+
+#[derive(Default)]
+struct ReviewDocument {
+    token: String,
+    generation: Option<u64>,
+    next_id: u32,
+    keys: HashMap<String, u32>,
+    native: BTreeMap<(usize, usize), u32>,
+    native_keys: BTreeMap<(usize, usize), String>,
+    project: project::Project,
+    edits: BTreeMap<u32, String>,
+    replies: BTreeMap<u32, String>,
+    edit_request: u64,
+    edit: Option<u32>,
+}
+
+fn numeric_id(p: &Value) -> Result<u32, String> {
+    p.get("id").and_then(Value::as_u64).and_then(|v| u32::try_from(v).ok()).ok_or_else(|| "invalid comment id".into())
+}
+
+impl PdfCraftApp {
+    pub fn enable_host_review(&mut self) {
+        if self.host_review.is_none() {
+            self.host_review = Some(HostReview::default());
+            self.left_open = false;
+        }
+        if self.right == Some(crate::RightPanel::Comments) {
+            self.right = None;
+        }
+        self.comments_panel_closed = true;
+        self.right_panel_closed = true;
+        for view in &mut self.views {
+            if !view.host_comments {
+                view.host_comments = true;
+                view.fit = crate::canvas::Fit::Width;
+                view.layout = crate::canvas::PageLayout::Single;
+            }
+        }
+    }
+
+    fn sync_host_review(&mut self) -> Option<(usize, DocId)> {
+        let (i, id) = self.active_ids()?;
+        let host = self.host_review.as_mut()?;
+        host.documents.retain(|id, _| self.views.iter().any(|v| v.id == *id));
+        if !host.documents.contains_key(&id) {
+            host.serial = host.serial.saturating_add(1);
+            host.documents.insert(id, ReviewDocument { token: format!("{}:{}", id.0, host.serial), ..Default::default() });
+        }
+        let state = host.documents.get_mut(&id)?;
+        let doc = self.session.get(id)?;
+        if state.generation != Some(doc.edit_generation()) {
+            state.native.clear();
+            state.native_keys.clear();
+            for (page, index, key) in doc.comment_keys().into_iter().take(50_000) {
+                let numeric = *state.keys.entry(key.clone()).or_insert_with(|| {
+                    state.next_id = state.next_id.saturating_add(1);
+                    state.next_id
+                });
+                state.native.insert((page, index), numeric);
+                state.native_keys.insert((page, index), key);
+            }
+            let current: HashSet<u32> = state.native.values().copied().collect();
+            state.edits.retain(|key, _| current.contains(key));
+            state.replies.retain(|key, _| current.contains(key));
+            state.generation = Some(doc.edit_generation());
+        }
+        self.sync_host_project(i, id);
+        Some((i, id))
+    }
+
+    fn comment_native(&mut self, numeric: u32) -> Result<(usize, usize), String> {
+        let (_, id) = self.sync_host_review().ok_or("no document")?;
+        self.host_review
+            .as_ref()
+            .and_then(|s| s.documents.get(&id))
+            .and_then(|s| s.native.iter().find(|(_, n)| **n == numeric).map(|(at, _)| *at))
+            .filter(|(page, index)| self.session.get(id).is_some_and(|d| d.info.annotations.iter().any(|a| a.page == *page && a.index == *index)))
+            .ok_or_else(|| "the comment no longer exists".into())
+    }
+
+    // Inline PDF dictionaries become indirect objects on their first mutation. Keep their card
+    // identity at that moment; subsequent edits and deletions use the native object reference.
+    fn apply_host_comment(&mut self, edit: Edit, keep: Option<(u32, usize, usize)>) -> Result<(), String> {
+        if !self.apply_edit(edit) {
+            return Err("PDF refused the comment change; your draft is retained".into());
+        }
+        if let Some((numeric, page, index)) = keep
+            && let Some((_, id)) = self.active_ids()
+            && let Some(key) =
+                self.session.get(id).and_then(|d| d.comment_keys().into_iter().find(|(p, n, _)| *p == page && *n == index).map(|(_, _, key)| key))
+            && let Some(state) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id))
+        {
+            state.keys.insert(key, numeric);
+            state.generation = None;
+        }
+        self.sync_host_review();
+        Ok(())
+    }
+
+    fn flush_host_comments(&mut self) -> Result<(), String> {
+        let (_, id) = self.sync_host_review().ok_or("no document")?;
+        let (edits, replies) =
+            self.host_review.as_ref().and_then(|h| h.documents.get(&id)).map(|s| (s.edits.clone(), s.replies.clone())).unwrap_or_default();
+        for (numeric, text) in edits {
+            let (page, index) = self.comment_native(numeric)?;
+            let same = self.session.get(id).is_some_and(|d| {
+                d.info.annotations.iter().any(|a| a.page == page && a.index == index && a.contents.as_deref().unwrap_or("") == text)
+            });
+            if !same {
+                self.apply_host_comment(Edit::SetAnnotationContents { page, index, text }, Some((numeric, page, index)))?;
+            }
+            if let Some(s) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)) {
+                s.edits.remove(&numeric);
+            }
+        }
+        for (numeric, text) in replies {
+            if !text.trim().is_empty() {
+                self.post_host_reply(numeric)?;
+            }
+        }
+        Ok(())
+    }
+
+    fn post_host_reply(&mut self, numeric: u32) -> Result<(), String> {
+        let (page, index) = self.comment_native(numeric)?;
+        let (_, id) = self.active_ids().ok_or("no document")?;
+        let text = self.host_review.as_ref().and_then(|h| h.documents.get(&id)).and_then(|s| s.replies.get(&numeric)).cloned().unwrap_or_default();
+        if text.trim().is_empty() {
+            return Err("reply is empty".into());
+        }
+        self.apply_host_comment(
+            Edit::ReplyToAnnotation { page, index, text, author: self.comment_prefs.author.clone() },
+            Some((numeric, page, index)),
+        )?;
+        if let Some(s) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)) {
+            s.replies.remove(&numeric);
+        }
+        Ok(())
+    }
+
+    pub(crate) fn host_review_dirty(&self, id: DocId) -> bool {
+        if self
+            .views
+            .iter()
+            .any(|v| v.id == id && v.host_composer_fallback && v.comments.composer.as_ref().is_some_and(|c| !c.text.trim().is_empty()))
+        {
+            return true;
+        }
+        self.host_review
+            .as_ref()
+            .and_then(|h| h.documents.get(&id))
+            .is_some_and(|s| !s.edits.is_empty() || s.replies.values().any(|text| !text.trim().is_empty()))
+    }
+
+    pub(crate) fn host_review_flush(&mut self, id: DocId) -> bool {
+        if self
+            .views
+            .iter()
+            .any(|v| v.id == id && v.host_composer_fallback && v.comments.composer.as_ref().is_some_and(|c| !c.text.trim().is_empty()))
+        {
+            self.notify("Finish or cancel the comment that could not be added before saving".to_string());
+            return false;
+        }
+        if !self.host_review_dirty(id) {
+            return true;
+        }
+        match self.flush_host_comments() {
+            Ok(()) => true,
+            Err(e) => {
+                self.notify(e);
+                false
+            }
+        }
+    }
+
+    pub(crate) fn host_review_reverted(&mut self, id: DocId) {
+        if let Some(h) = self.host_review.as_mut() {
+            h.documents.remove(&id);
+        }
+    }
+
+    fn select_host_comment(&mut self, numeric: u32) -> Result<(), String> {
+        let (page, index) = self.comment_native(numeric)?;
+        let (i, id) = self.active_ids().ok_or("no document")?;
+        let top = self
+            .session
+            .get(id)
+            .and_then(|d| {
+                let p = d.info.pages.get(page)?;
+                let a = d.info.annotations.iter().find(|a| a.page == page && a.index == index)?;
+                let xf = crate::canvas::PageXform {
+                    rect: egui::Rect::from_min_size(egui::Pos2::ZERO, egui::Vec2::splat(1.0)),
+                    rot: self.views[i].rotation,
+                    pw: p.width,
+                    ph: p.height,
+                };
+                Some((xf.user_rect(&d.info, page, a.shown_rect(p.rotation)).top() - 0.03).clamp(0.0, 1.0))
+            })
+            .unwrap_or(0.0);
+        self.views[i].comments.selected = Some((page, index));
+        self.views[i].go_to_page(page);
+        self.views[i].goto = Some((page, top));
+        Ok(())
+    }
+
+    fn add_host_note(&mut self, page: usize, at: [f64; 2], text: String) -> Result<Value, String> {
+        self.add_host_annotation(NewAnnotation {
+            page,
+            shape: Shape::Note { at, icon: NoteIcon::Comment },
+            style: self.comment_prefs.style(crate::comments::CommentTool::Note),
+            contents: text,
+            author: self.comment_prefs.author.clone(),
+        })
+    }
+
+    fn add_host_annotation(&mut self, annotation: NewAnnotation) -> Result<Value, String> {
+        let page = annotation.page;
+        self.apply_host_comment(Edit::AddAnnotation(annotation), None)?;
+        let (i, id) = self.active_ids().ok_or("no document")?;
+        let index = self
+            .session
+            .get(id)
+            .and_then(|d| d.info.annotations.iter().filter(|a| a.page == page && a.is_comment()).map(|a| a.index).max())
+            .ok_or("comment was not added")?;
+        self.views[i].comments.selected = Some((page, index));
+        self.quick_tool = crate::QuickTool::Select;
+        let numeric = self
+            .host_review
+            .as_ref()
+            .and_then(|h| h.documents.get(&id))
+            .and_then(|s| s.native.get(&(page, index)))
+            .copied()
+            .ok_or("comment identity unavailable")?;
+        Ok(json!({"id":numeric}))
+    }
+
+    pub fn host_review_command(&mut self, document: &str, action: &str, params: &Value) -> Result<Value, String> {
+        let (i, id) = self.sync_host_review().ok_or("no document")?;
+        if self.host_review.as_ref().and_then(|h| h.documents.get(&id)).is_none_or(|s| s.token != document) {
+            return Err("the document has changed".into());
+        }
+        match action {
+            "configure" => return self.configure_host_project(i, id, params),
+            "locate" => return self.locate_host_clause(i, id, params.get("id").and_then(Value::as_str).ok_or("missing clause id")?),
+            "upsert" => return self.upsert_host_comment(i, id, params),
+            "draft" | "replyDraft" => {
+                let numeric = numeric_id(params)?;
+                let (page, index) = self.comment_native(numeric)?;
+                let check = if action == "draft" {
+                    Edit::SetAnnotationContents { page, index, text: String::new() }
+                } else {
+                    Edit::ReplyToAnnotation { page, index, text: String::new(), author: self.comment_prefs.author.clone() }
+                };
+                self.session.check_host_review_edit(id, &check).map_err(|e| e.to_string())?;
+                if !self.session.get(id).is_some_and(|d| d.allows_annotation() && d.read_only_reason.is_none()) {
+                    return Err("PDF is read only".into());
+                }
+                let text = params.get("text").and_then(Value::as_str).ok_or("missing text")?;
+                if text.len() > 1_048_576 {
+                    return Err("comment is too long".into());
+                }
+                if let Some(s) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)) {
+                    let target = if action == "draft" { &mut s.edits } else { &mut s.replies };
+                    target.insert(numeric, text.to_string());
+                }
+            }
+            "cancelEdit" | "cancelReply" => {
+                let numeric = numeric_id(params)?;
+                if let Some(s) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)) {
+                    if action == "cancelEdit" {
+                        s.edits.remove(&numeric);
+                    } else {
+                        s.replies.remove(&numeric);
+                    }
+                }
+            }
+            "flush" => self.flush_host_comments()?,
+            "reply" => self.post_host_reply(numeric_id(params)?)?,
+            "select" => self.select_host_comment(numeric_id(params)?)?,
+            "new" => {
+                self.flush_host_comments()?;
+                if let Some((page, quads)) = self.session.get(id).and_then(|d| self.views[i].selection_quads(&d.info)) {
+                    return self.add_host_annotation(NewAnnotation {
+                        page,
+                        shape: Shape::TextMarkup { kind: pdfcraft_engine::Markup::Highlight, quads },
+                        style: self.comment_prefs.style(crate::comments::CommentTool::Note),
+                        contents: String::new(),
+                        author: self.comment_prefs.author.clone(),
+                    });
+                }
+                if self.host_review.as_ref().and_then(|h| h.documents.get(&id)).is_some_and(|s| s.project.configured && !s.project.body) {
+                    return Err("Select text in an editable clause before adding a comment".into());
+                }
+                let page = self.views[i].current;
+                let at = self.session.get(id).and_then(|d| d.info.pages.get(page)).map(|p| p.view_to_user(p.width - 44.0, 24.0)).ok_or("no page")?;
+                return self.add_host_note(page, at.map(f64::from), String::new());
+            }
+            "previous" | "next" => {
+                self.flush_host_comments()?;
+                let state = self.host_review.as_ref().and_then(|h| h.documents.get(&id)).ok_or("no document")?;
+                let notes: Vec<u32> = self
+                    .session
+                    .get(id)
+                    .map(|d| {
+                        d.info
+                            .annotations
+                            .iter()
+                            .filter(|a| a.is_comment())
+                            .filter_map(|a| state.native.get(&(a.page, a.index)).copied())
+                            .take(2000)
+                            .collect()
+                    })
+                    .unwrap_or_default();
+                if notes.is_empty() {
+                    return Ok(json!({}));
+                }
+                let current = self.views[i].comments.selected.and_then(|at| state.native.get(&at)).and_then(|n| notes.iter().position(|v| v == n));
+                let n = if action == "next" {
+                    current.map_or(0, |n| (n + 1) % notes.len())
+                } else {
+                    current.map_or(notes.len() - 1, |n| (n + notes.len() - 1) % notes.len())
+                };
+                self.select_host_comment(notes[n])?;
+            }
+            "resolve" | "delete" => {
+                self.flush_host_comments()?;
+                let numeric = numeric_id(params)?;
+                let (page, index) = self.comment_native(numeric)?;
+                if action == "delete" {
+                    self.apply_host_comment(Edit::DeleteAnnotation { page, index }, None)?;
+                } else {
+                    let doc = self.session.get(id).ok_or("no document")?;
+                    let tops = pdfcraft_render::thread_tops(&doc.info.annotations);
+                    let completed = doc
+                        .info
+                        .annotations
+                        .iter()
+                        .rfind(|a| tops.get(&(a.page, a.index)) == Some(&(page, index)) && a.state.is_some() && !a.is_mark())
+                        .is_some_and(|a| a.state.as_deref() == Some("Completed"));
+                    self.apply_host_comment(
+                        Edit::SetAnnotationStatus {
+                            page,
+                            index,
+                            state: if completed { ReviewState::None } else { ReviewState::Completed },
+                            author: self.comment_prefs.author.clone(),
+                        },
+                        Some((numeric, page, index)),
+                    )?;
+                }
+            }
+            "save" => {
+                self.flush_host_comments()?;
+                if !self.save_active(crate::SaveTarget::InPlace) {
+                    return Err("PDF could not be saved".into());
+                }
+            }
+            _ => return Err("unsupported comment action".into()),
+        }
+        Ok(json!({}))
+    }
+
+    /// Divert the native sticky-note composer into the shared DOM card, preserving its anchor.
+    pub fn host_review_tick(&mut self) {
+        if self.host_review.is_none() {
+            return;
+        }
+        self.enable_host_review();
+        let Some((i, id)) = self.sync_host_review() else { return };
+        if self.views[i].comments.composer.is_none() {
+            self.views[i].host_composer_fallback = false;
+        }
+        if self.views[i].host_composer_fallback {
+            return;
+        }
+        let pending = self.views[i]
+            .comments
+            .composer
+            .as_ref()
+            .filter(|c| matches!(c.kind, crate::comments::ComposerKind::Note | crate::comments::ComposerKind::Edit(_)))
+            .cloned();
+        if let Some(c) = pending {
+            let result = match c.kind {
+                crate::comments::ComposerKind::Note => self.add_host_note(c.page, c.at, c.text.clone()).map(|_| ()),
+                crate::comments::ComposerKind::Edit(index) => {
+                    let numeric = self.host_review.as_ref().and_then(|h| h.documents.get(&id)).and_then(|s| s.native.get(&(c.page, index))).copied();
+                    if let Some(numeric) = numeric {
+                        self.views[i].comments.selected = Some((c.page, index));
+                        if let Some(s) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)) {
+                            s.edit = Some(numeric);
+                            s.edit_request = s.edit_request.saturating_add(1);
+                        }
+                    }
+                    Ok(())
+                }
+                _ => Ok(()),
+            };
+            if result.is_ok() {
+                self.views[i].comments.composer = None;
+            } else if let Err(e) = result {
+                self.notify(e);
+                self.views[i].host_composer_fallback = true;
+            }
+        }
+    }
+
+    pub fn host_review_snapshot(&mut self, ctx: &egui::Context, applied: u64) -> Value {
+        let Some((i, id)) = self.sync_host_review() else {
+            return json!({"document":"","notes":[],"pages":[],"clip":null,"selection":null,"active":null,"author":self.comment_prefs.author,"editable":false,"formatting":false,"applied":applied});
+        };
+        let source = self.host_source_state(i, id);
+        let Some(doc) = self.session.get(id) else { return Value::Null };
+        let Some(host) = self.host_review.as_ref() else { return Value::Null };
+        let Some(state) = host.documents.get(&id) else { return Value::Null };
+        let view = &self.views[i];
+        let zoom = ctx.zoom_factor().clamp(0.25, 5.0);
+        let rect = |r: egui::Rect| json!({"x":r.min.x*zoom,"y":r.min.y*zoom,"w":r.width()*zoom,"h":r.height()*zoom});
+        let area = host.clip.unwrap_or(view.viewport_rect());
+        let pages: Vec<Value> = view.visible_page_rects().into_iter().map(|(page,r)| json!({"page":page,"x":r.min.x*zoom,"y":r.min.y*zoom,"w":r.width()*zoom,"h":r.height()*zoom,"margin":(area.right()-r.right()).max(0.0)*zoom})).collect();
+        let tops = pdfcraft_render::thread_tops(&doc.info.annotations);
+        let mut source_ranges = Vec::new();
+        if state.project.status == "matched" {
+            if let Some(Ok(found)) = state
+                .project
+                .selected
+                .as_ref()
+                .and_then(|id| state.project.matches.get(id))
+                .filter(|found| found.as_ref().is_ok_and(|m| m.len() == 1))
+            {
+                if let Some((page, quads)) = found.first() {
+                    if let Some(xf) = view.page_xform(*page) {
+                        for q in quads {
+                            let mut bounds = [f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY];
+                            for p in q.chunks_exact(2) {
+                                bounds[0] = bounds[0].min(p[0]);
+                                bounds[1] = bounds[1].min(p[1]);
+                                bounds[2] = bounds[2].max(p[0]);
+                                bounds[3] = bounds[3].max(p[1]);
+                            }
+                            let r = xf.user_rect(&doc.info, *page, bounds.map(|n| n as f32));
+                            if r.is_finite() {
+                                let mut r = rect(r);
+                                r["page"] = json!(page);
+                                source_ranges.push(r);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        let mut notes = Vec::new();
+        for a in doc.info.annotations.iter().filter(|a| a.is_comment()).take(2000) {
+            let Some(numeric) = state.native.get(&(a.page, a.index)).copied() else { continue };
+            let mut ranges = Vec::new();
+            if let Some(xf) = view.page_xform(a.page) {
+                let r = xf.user_rect(&doc.info, a.page, a.shown_rect(doc.info.pages.get(a.page).map_or(0, |p| p.rotation)));
+                if r.is_finite() {
+                    let mut r = rect(r);
+                    r["page"] = json!(a.page);
+                    ranges.push(r);
+                }
+            }
+            let thread: Vec<_> = doc.info.annotations.iter().filter(|r| tops.get(&(r.page, r.index)) == Some(&(a.page, a.index))).collect();
+            let resolved = thread.iter().rfind(|r| r.state.is_some() && !r.is_mark()).is_some_and(|r| r.state.as_deref() == Some("Completed"));
+            let replies: Vec<Value> = thread
+                .iter()
+                .filter(|r| r.is_reply() && r.state.is_none() && !r.grouped)
+                .filter_map(|r| Some(json!({"id":state.native.get(&(r.page,r.index))?,"nativeKey":state.native_keys.get(&(r.page,r.index)),"author":r.author,"text":r.contents.as_deref().unwrap_or("")})))
+                .collect();
+            notes.push(json!({"id":numeric,"nativeKey":state.native_keys.get(&(a.page,a.index)),"quote":state.native_keys.get(&(a.page,a.index)).and_then(|key|state.project.quotes.get(key)).cloned().unwrap_or_default(),"clauseId":state.native_keys.get(&(a.page,a.index)).and_then(|key|state.project.associations.get(key)),"page":a.page,"author":a.author,"text":state.edits.get(&numeric).map(String::as_str).unwrap_or(a.contents.as_deref().unwrap_or("")),"date":a.modified,"resolved":resolved,"color":(numeric-1)%3,"ranges":ranges,"replies":replies,"highlight":false}));
+        }
+        let active = view.comments.selected.and_then(|at| tops.get(&at).copied().or(Some(at))).and_then(|at| state.native.get(&at));
+        json!({"fileName":doc.name,"source":source,"sourceRanges":source_ranges,"complete":doc.info.annotations.iter().filter(|a|a.is_comment()).count()<=2000&&state.native.len()<50_000,"document":state.token,"notes":notes,"pages":pages,"clip":rect(area),"selection":null,"active":active,"author":self.comment_prefs.author,"editable":self.session.host_review_editable(id)&&doc.allows_annotation()&&doc.read_only_reason.is_none(),"formatting":false,"applied":applied,"edit":state.edit,"editRequest":state.edit_request})
+    }
+}
