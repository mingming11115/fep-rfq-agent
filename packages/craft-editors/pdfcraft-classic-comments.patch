+//! In-memory host permissions and bounded quote navigation, separate from PDF security.
+use crate::{DocId, Document, Edit, EditError, Session, Shape};
+use std::collections::HashMap;
+
+#[derive(Default)]
+pub(crate) struct HostAccess {
+    defaults: (bool, bool),
+    documents: HashMap<DocId, Access>,
+}
+struct Access {
+    editable: bool,
+    body: bool,
+    author: String,
+    regions: Vec<(usize, [f64; 4], bool)>,
+    rules: HashMap<String, [bool; 5]>,
+}
+impl Document {
+    pub fn host_comment_quote(&self, page: usize, index: usize) -> String {
+        let Some(a) = self.info.annotations.iter().find(|a| a.page == page && a.index == index && !a.quads.is_empty()) else { return String::new() };
+        let Some(info) = self.info.pages.get(page) else { return String::new() };
+        let Some(bounds) = quads_box(&a.quads.iter().map(|q| q.map(f64::from)).collect::<Vec<_>>()) else { return String::new() };
+        let mut renderer = pdfcraft_render::PageRenderer::new(self.bytes.clone(), self.config.clone());
+        let Some(text) =
+            renderer.render(pdfcraft_render::RenderRequest { page, kind: pdfcraft_render::RequestKind::Text, ..Default::default() }).text
+        else {
+            return String::new();
+        };
+        let selected: Vec<usize> = text
+            .glyphs
+            .iter()
+            .enumerate()
+            .take(500_000)
+            .filter_map(|(index, g)| {
+                let [x, y] = info.view_to_user((g.rect[0] + g.rect[2]) * 0.5, (g.rect[1] + g.rect[3]) * 0.5);
+                let (x, y) = (f64::from(x), f64::from(y));
+                (x >= bounds[0] - 1.0 && x <= bounds[2] + 1.0 && y >= bounds[1] - 1.0 && y <= bounds[3] + 1.0).then_some(index)
+            })
+            .collect();
+        if let (Some(first), Some(last)) = (selected.first(), selected.last()) {
+            text.text_of(*first..last.saturating_add(1)).split_whitespace().collect::<Vec<_>>().join(" ")
+        } else {
+            String::new()
+        }
+    }
+    /// Case-sensitive, whitespace-aware native text search. Two matches establish ambiguity;
+    /// no raster is produced and no annotation or document state is changed.
+    pub fn host_quote_matches(&self, quote: &str, page: Option<usize>) -> Result<Vec<(usize, Vec<[f64; 8]>)>, String> {
+        if quote.trim().is_empty() || quote.len() > 1_048_576 {
+            return Err("quote is empty or too long".into());
+        }
+        if self.info.pages.len() > 1000 {
+            return Err("source has too many pages for bounded quote search".into());
+        }
+        if page.is_some_and(|p| p >= self.info.pages.len()) {
+            return Err("source page is outside the document".into());
+        }
+        let mut renderer = pdfcraft_render::PageRenderer::new(self.bytes.clone(), self.config.clone());
+        let mut found = Vec::new();
+        for (index, info) in self.info.pages.iter().enumerate().filter(|(index, _)| page.is_none_or(|p| p == *index)) {
+            let result =
+                renderer.render(pdfcraft_render::RenderRequest { page: index, kind: pdfcraft_render::RequestKind::Text, ..Default::default() });
+            if let Some(error) = result.error {
+                return Err(error);
+            }
+            let text = result.text.ok_or("native text extraction is unavailable")?;
+            for range in text.find_opts_limited(quote, true, false, 2usize.saturating_sub(found.len())) {
+                let quads = text.line_rects(range).into_iter().map(|r| info.view_rect_to_quad(r)).collect::<Vec<_>>();
+                if !quads.is_empty() {
+                    found.push((index, quads));
+                }
+                if found.len() >= 2 {
+                    return Ok(found);
+                }
+            }
+        }
+        Ok(found)
+    }
+}
+fn box_of(shape: &Shape) -> Option<[f64; 4]> {
+    match shape {
+        Shape::Note { at, .. } => Some([at[0], at[1], at[0], at[1]]),
+        Shape::TextMarkup { quads, .. } => quads_box(quads),
+        Shape::Rectangle { rect } | Shape::Oval { rect } | Shape::Caret { rect } => Some(*rect),
+        _ => None,
+    }
+}
+pub(crate) fn quads_box(quads: &[[f64; 8]]) -> Option<[f64; 4]> {
+    let mut rect = [f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY];
+    for q in quads.iter().take(100_000) {
+        for point in q.chunks_exact(2) {
+            let (x, y) = (point[0], point[1]);
+            if !x.is_finite() || !y.is_finite() {
+                return None;
+            }
+            rect[0] = rect[0].min(x);
+            rect[1] = rect[1].min(y);
+            rect[2] = rect[2].max(x);
+            rect[3] = rect[3].max(y);
+        }
+    }
+    rect.iter().all(|n| n.is_finite()).then_some(rect)
+}
+impl Session {
+    pub fn set_host_review_defaults(&mut self, editable: bool, body: bool) {
+        self.host_access.get_or_insert_with(Default::default).defaults = (editable, body);
+    }
+    pub fn set_host_review_access(
+        &mut self,
+        id: DocId,
+        editable: bool,
+        body: bool,
+        author: String,
+        regions: Vec<(usize, [f64; 4], bool)>,
+        rules: HashMap<String, [bool; 5]>,
+    ) {
+        self.host_access.get_or_insert_with(Default::default).documents.insert(id, Access { editable, body, author, regions, rules });
+    }
+    pub fn host_review_editable(&self, id: DocId) -> bool {
+        self.host_access.as_ref().is_none_or(|h| h.documents.get(&id).map_or(h.defaults.0, |a| a.editable))
+    }
+    pub(crate) fn host_history_allowed(&self, id: DocId) -> bool {
+        self.host_access.as_ref().is_none_or(|h| h.documents.get(&id).map_or(h.defaults.1, |a| a.body))
+    }
+    pub fn check_host_review_edit(&self, id: DocId, edit: &Edit) -> Result<(), EditError> {
+        let Some(host) = &self.host_access else { return Ok(()) };
+        let denied = || EditError::ReadOnly("the host does not permit this document or comment change".into());
+        let Some(access) = host.documents.get(&id) else { return Err(denied()) };
+        let doc = self.get(id).ok_or(EditError::NoDocument)?;
+        fn region(access: &Access, page: usize, rect: Option<[f64; 4]>) -> bool {
+            let Some(r) = rect else { return access.body };
+            let mut allowed = false;
+            for (p, b, editable) in &access.regions {
+                if *p != page {
+                    continue;
+                }
+                let overlaps = r[0] <= b[2] + 2.0 && r[2] >= b[0] - 2.0 && r[1] <= b[3] + 2.0 && r[3] >= b[1] - 2.0;
+                if overlaps {
+                    if !editable {
+                        return false;
+                    }
+                    allowed |= r[0] >= b[0] - 2.0 && r[1] >= b[1] - 2.0 && r[2] <= b[2] + 2.0 && r[3] <= b[3] + 2.0;
+                }
+            }
+            allowed || access.body
+        }
+        fn check(
+            doc: &Document,
+            access: &Access,
+            edit: &Edit,
+            created: &mut HashMap<(usize, usize), String>,
+            next: &mut HashMap<usize, usize>,
+            depth: usize,
+        ) -> Result<(), EditError> {
+            let denied = || EditError::ReadOnly("the host does not permit this document or comment change".into());
+            if depth >= 32 {
+                return Err(denied());
+            }
+            if let Edit::Batch { edits, .. } = edit {
+                if edits.iter().any(|e| matches!(e, Edit::DeleteAnnotation { .. })) {
+                    return Err(denied());
+                }
+                for e in edits {
+                    check(doc, access, e, created, next, depth + 1)?;
+                }
+                return Ok(());
+            }
+            if let Edit::AddAnnotation(a) = edit {
+                if !access.editable || !region(access, a.page, box_of(&a.shape)) {
+                    return Err(denied());
+                }
+                let index = next.entry(a.page).or_default();
+                created.insert((a.page, *index), a.author.clone());
+                *index = index.saturating_add(if matches!(a.shape, Shape::Note { .. }) { 2 } else { 1 });
+                return Ok(());
+            }
+            let (page, index, permission) = match edit {
+                Edit::ReplyToAnnotation { page, index, .. } => (*page, *index, 2),
+                Edit::SetAnnotationStatus { page, index, .. } | Edit::MarkAnnotation { page, index, .. } => (*page, *index, 3),
+                Edit::DeleteAnnotation { page, index } => (*page, *index, 4),
+                Edit::SetAnnotationContents { page, index, .. }
+                | Edit::MoveAnnotation { page, index, .. }
+                | Edit::ResizeAnnotation { page, index, .. }
+                | Edit::ReshapeAnnotation { page, index, .. }
+                | Edit::StyleAnnotation { page, index, .. }
+                | Edit::FillAnnotation { page, index, .. }
+                | Edit::FontSizeAnnotation { page, index, .. }
+                | Edit::SetAnnotationInfo { page, index, .. }
+                | Edit::LockAnnotation { page, index, .. }
+                | Edit::EraseInk { page, index, .. } => (*page, *index, 1),
+                _ => return if access.body { Ok(()) } else { Err(denied()) },
+            };
+            if !access.editable {
+                return Err(denied());
+            }
+            if !created.contains_key(&(page, index)) {
+                let a = doc.info.annotations.iter().find(|a| a.page == page && a.index == index).ok_or_else(denied)?;
+                if matches!(permission, 1 | 4) && a.author.as_deref() != Some(access.author.as_str()) {
+                    return Err(denied());
+                }
+                let tops = pdfcraft_render::thread_tops(&doc.info.annotations);
+                let root = tops.get(&(page, index)).copied().unwrap_or((page, index));
+                let key = doc.comment_keys().into_iter().find(|(p, i, _)| (*p, *i) == root).map(|(_, _, key)| key).ok_or_else(denied)?;
+                let effective = if permission == 1 && root != (page, index) { 2 } else { permission };
+                let allowed =
+                    access.rules.get(&key).map(|r| r[0] && r[effective]).unwrap_or_else(|| region(access, a.page, Some(a.rect.map(f64::from))));
+                if !allowed {
+                    return Err(denied());
+                }
+            }
+            if let Edit::ReplyToAnnotation { author, .. } | Edit::SetAnnotationStatus { author, .. } = edit {
+                let at = next.entry(page).or_default();
+                created.insert((page, *at), author.clone());
+                *at = at.saturating_add(1);
+            }
+            Ok(())
+        }
+        let mut next = HashMap::new();
+        for (page, index, _) in doc.comment_keys() {
+            let n = next.entry(page).or_insert(0usize);
+            *n = (*n).max(index.saturating_add(1));
+        }
+        check(doc, access, edit, &mut HashMap::new(), &mut next, 0)
+    }
+}
