+use super::*;
+fn app(text: &str) -> PdfCraftApp {
+    let mut a = PdfCraftApp::new();
+    let bytes = a.session.create_from_text("Source", text).unwrap();
+    a.open_bytes("source.pdf", None, bytes.to_vec()).unwrap();
+    a.comment_prefs.author = "Reviewer".into();
+    a.enable_host_review();
+    a
+}
+fn command(a: &mut PdfCraftApp, action: &str, p: Value) -> Result<Value, String> {
+    let document = a.host_review_snapshot(&egui::Context::default(), 0)["document"].as_str().unwrap().to_string();
+    a.host_review_command(&document, action, &p)
+}
+fn configure(a: &mut PdfCraftApp, editable: bool) {
+    command(a,"configure",json!({"editable":editable,"editDocument":false,"targets":[{"id":"c1","quote":"Unique clause","editable":true},{"id":"c2","quote":"Repeated","editable":false}]})).unwrap();
+}
+#[test]
+fn project_pdf_locate_unique_ambiguous_missing_page_and_native_selection() {
+    let mut a = app("Unique clause\nRepeated Repeated");
+    configure(&mut a, true);
+    assert_eq!(command(&mut a, "locate", json!({"id":"c1"})).unwrap()["status"], "matched");
+    assert_eq!(command(&mut a, "locate", json!({"id":"c2"})).unwrap()["status"], "ambiguous");
+    command(&mut a,"configure",json!({"editable":true,"editDocument":false,"targets":[{"id":"c1","quote":"Unique clause","editable":true},{"id":"missing","quote":"Absent","page":0,"editable":true}]})).unwrap();
+    assert_eq!(command(&mut a, "locate", json!({"id":"missing"})).unwrap()["status"], "page");
+    assert!(a.views[0].selected_text().is_none());
+    let doc = a.session.get(a.views[0].id).unwrap();
+    let mut renderer = pdfcraft_render::PageRenderer::new(doc.bytes.clone(), Default::default());
+    let text =
+        renderer.render(pdfcraft_render::RenderRequest { page: 0, kind: pdfcraft_render::RequestKind::Text, ..Default::default() }).text.unwrap();
+    let range = text.find_opts_limited("Unique clause", true, false, 2)[0].clone();
+    a.views[0].texts.insert(0, text);
+    a.views[0].select_text(0, range.start, range.end - 1);
+    assert_eq!(a.host_review_snapshot(&egui::Context::default(), 0)["source"]["selectedId"], "c1");
+    assert!(command(&mut a, "upsert", json!({"text":"Never guess","author":"Reviewer","quote":"Absent","clauseId":"missing","replies":[]})).is_err());
+}
+#[test]
+fn project_pdf_upsert_roundtrip_preserves_native_identity_authors_replies_and_resolution() {
+    let mut a = app("Unique clause");
+    configure(&mut a, true);
+    let params = json!({"text":"Business comment","author":"Reviewer","resolved":true,"quote":"Unique clause","clauseId":"c1","replies":[{"text":"Imported reply","author":"Colleague"}]});
+    let first = command(&mut a, "upsert", params.clone()).unwrap();
+    let mut again = params.clone();
+    again["id"] = first["id"].clone();
+    again["replies"][0]["id"] = first["replies"][0]["id"].clone();
+    assert_eq!(command(&mut a, "upsert", again).unwrap(), first);
+    let snap = a.host_review_snapshot(&egui::Context::default(), 0);
+    let note = &snap["notes"][0];
+    assert_eq!(note["nativeKey"], first["nativeKey"]);
+    assert_eq!(note["quote"], "Unique clause");
+    assert_eq!(note["clauseId"], "c1");
+    assert_eq!(note["resolved"], true);
+    assert_eq!(note["replies"].as_array().unwrap().len(), 1);
+    assert_eq!(note["replies"][0]["author"], "Colleague");
+    let id = a.views[0].id;
+    let bytes = a.session.save_bytes(id).unwrap();
+    let mut reopened = pdfcraft_engine::Session::new();
+    let id = reopened.open("saved.pdf", None, bytes, None).unwrap();
+    let doc = reopened.get(id).unwrap();
+    assert!(doc.info.annotations.iter().any(|a| a.contents.as_deref() == Some("Business comment") && a.author.as_deref() == Some("Reviewer")));
+    assert_eq!(
+        doc.info.annotations.iter().filter(|a| a.contents.as_deref() == Some("Imported reply") && a.author.as_deref() == Some("Colleague")).count(),
+        1
+    );
+    assert!(doc.info.annotations.iter().any(|a| a.state.as_deref() == Some("Completed")));
+}
