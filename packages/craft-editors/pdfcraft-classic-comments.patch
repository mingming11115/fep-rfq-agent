+//! Project clauses and comment synchronization. None of this metadata becomes PDF security.
+use super::*;
+use pdfcraft_engine::{Markup, Style};
+
+type Match = (usize, Vec<[f64; 8]>);
+#[derive(Default)]
+pub(super) struct Project {
+    pub configured: bool,
+    pub editable: bool,
+    pub body: bool,
+    pub targets: Vec<Value>,
+    pub associations: HashMap<String, String>,
+    pub rules: HashMap<String, [bool; 5]>,
+    pub selected: Option<String>,
+    pub status: String,
+    pub selection: String,
+    pub generation: Option<u64>,
+    pub matches: HashMap<String, Result<Vec<Match>, String>>,
+    pub quotes: HashMap<String, String>,
+}
+fn bounds(quads: &[[f64; 8]]) -> Option<[f64; 4]> {
+    let mut r = [f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY];
+    for q in quads {
+        for p in q.chunks_exact(2) {
+            r[0] = r[0].min(p[0]);
+            r[1] = r[1].min(p[1]);
+            r[2] = r[2].max(p[0]);
+            r[3] = r[3].max(p[1]);
+        }
+    }
+    r.iter().all(|x| x.is_finite()).then_some(r)
+}
+impl PdfCraftApp {
+    /// Parse only saved file bytes for the save acknowledgement; live drafts cannot leak in.
+    pub fn saved_host_review(name: &str, bytes: &[u8], document: &str, applied: u64) -> Option<Value> {
+        if document.is_empty() || bytes.len() > 50 * 1024 * 1024 {
+            return None;
+        }
+        let mut session = pdfcraft_engine::Session::new();
+        let id = session.open(name, None, std::sync::Arc::new(bytes.to_vec()), None).ok()?;
+        let doc = session.get(id)?;
+        if doc.info.annotations.iter().filter(|a| a.is_comment()).count() > 2000 {
+            return None;
+        }
+        let keys: BTreeMap<(usize, usize), String> = doc.comment_keys().into_iter().map(|(p, i, key)| ((p, i), key)).collect();
+        if keys.len() > 50_000 {
+            return None;
+        }
+        let tops = pdfcraft_render::thread_tops(&doc.info.annotations);
+        let notes:Vec<Value>=doc.info.annotations.iter().filter(|a|a.is_comment()).filter_map(|a|{let root=(a.page,a.index);let thread:Vec<_>=doc.info.annotations.iter().filter(|r|tops.get(&(r.page,r.index))==Some(&root)).collect();let resolved=thread.iter().rfind(|r|r.state.is_some()&&!r.is_mark()).is_some_and(|r|r.state.as_deref()==Some("Completed"));let replies:Vec<Value>=thread.into_iter().filter(|r|r.is_reply()&&r.state.is_none()&&!r.grouped).filter_map(|r|Some(json!({"nativeKey":keys.get(&(r.page,r.index))?,"text":r.contents.as_deref().unwrap_or(""),"author":r.author}))).collect();Some(json!({"nativeKey":keys.get(&root)?,"text":a.contents.as_deref().unwrap_or(""),"author":a.author,"resolved":resolved,"replies":replies}))}).collect();
+        Some(json!({"document":document,"applied":applied,"notes":notes}))
+    }
+    pub fn set_host_review_permissions(&mut self, editable: bool, body: bool) {
+        self.enable_host_review();
+        if let Some(h) = &mut self.host_review {
+            h.initial = Some((editable, body));
+        }
+        self.session.set_host_review_defaults(editable, body);
+    }
+    pub(super) fn sync_host_project(&mut self, i: usize, id: DocId) {
+        let Some(h) = &mut self.host_review else { return };
+        let initial = h.initial;
+        let Some(s) = h.documents.get_mut(&id) else { return };
+        let p = &mut s.project;
+        if !p.configured {
+            if let Some((editable, body)) = initial {
+                p.configured = true;
+                p.editable = editable;
+                p.body = body;
+            } else {
+                return;
+            }
+        }
+        let Some(doc) = self.session.get(id) else { return };
+        if p.generation != Some(doc.edit_generation()) {
+            p.matches = p
+                .targets
+                .iter()
+                .filter_map(|t| {
+                    Some((
+                        t.get("id")?.as_str()?.to_string(),
+                        doc.host_quote_matches(
+                            t.get("quote").and_then(Value::as_str).unwrap_or(""),
+                            t.get("page").and_then(Value::as_u64).and_then(|n| usize::try_from(n).ok()),
+                        ),
+                    ))
+                })
+                .collect();
+            p.quotes = doc
+                .info
+                .annotations
+                .iter()
+                .filter(|a| a.is_comment())
+                .filter_map(|a| Some((s.native_keys.get(&(a.page, a.index))?.clone(), doc.host_comment_quote(a.page, a.index))))
+                .collect();
+            p.generation = Some(doc.edit_generation());
+        }
+        let mut regions = Vec::new();
+        for t in &p.targets {
+            let Some(clause) = t.get("id").and_then(Value::as_str) else { continue };
+            if let Some(Ok(m)) = p.matches.get(clause) {
+                if m.len() == 1 {
+                    if let Some((page, quads)) = m.first() {
+                        if let Some(r) = bounds(quads) {
+                            regions.push((*page, r, t.get("editable").and_then(Value::as_bool).unwrap_or(false)));
+                        }
+                    }
+                }
+            }
+        }
+        let rules = p
+            .associations
+            .iter()
+            .map(|(native, clause)| {
+                let allowed = p.targets.iter().any(|t| {
+                    t.get("id").and_then(Value::as_str) == Some(clause.as_str()) && t.get("editable").and_then(Value::as_bool) == Some(true)
+                });
+                let mut flags = p.rules.get(native).copied().unwrap_or([true; 5]);
+                flags[0] = allowed;
+                (native.clone(), flags)
+            })
+            .collect();
+        self.session.set_host_review_access(id, p.editable, p.body, self.comment_prefs.author.clone(), regions, rules);
+        let _ = i;
+    }
+    pub(super) fn configure_host_project(&mut self, i: usize, id: DocId, params: &Value) -> Result<Value, String> {
+        let targets = params.get("targets").and_then(Value::as_array).cloned().unwrap_or_default();
+        if targets.len() > 2000 {
+            return Err("too many clause targets".into());
+        }
+        let mut ids = HashSet::new();
+        for t in &targets {
+            let name = t.get("id").and_then(Value::as_str).filter(|s| !s.is_empty() && s.len() <= 256).ok_or("invalid clause id")?;
+            if !ids.insert(name.to_string()) {
+                return Err("duplicate clause id".into());
+            }
+            if t.get("quote").and_then(Value::as_str).unwrap_or("").len() > 1_048_576 {
+                return Err("clause quote is too long".into());
+            }
+        }
+        if let Some(bindings) = params.get("associations").and_then(Value::as_array) {
+            if bindings.len() > 50_000 {
+                return Err("too many comment associations".into());
+            }
+            for b in bindings {
+                if let Some(clause) = b.get("clauseId").and_then(Value::as_str) {
+                    if !ids.contains(clause) {
+                        return Err("association refers to an unknown clause".into());
+                    }
+                }
+            }
+        }
+        let p = &mut self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)).ok_or("no document")?.project;
+        p.configured = true;
+        p.editable = params.get("editable").and_then(Value::as_bool).unwrap_or(false);
+        p.body = params.get("editDocument").and_then(Value::as_bool).unwrap_or(false);
+        p.targets = targets;
+        p.generation = None;
+        if let Some(bindings) = params.get("associations").and_then(Value::as_array) {
+            if bindings.len() > 50_000 {
+                return Err("too many comment associations".into());
+            }
+            for b in bindings {
+                if let (Some(key), Some(clause)) = (b.get("nativeKey").and_then(Value::as_str), b.get("clauseId").and_then(Value::as_str)) {
+                    if !ids.contains(clause) {
+                        return Err("association refers to an unknown clause".into());
+                    }
+                    p.associations.insert(key.to_string(), clause.to_string());
+                    p.rules.insert(
+                        key.to_string(),
+                        [
+                            true,
+                            b.get("canEdit").and_then(Value::as_bool).unwrap_or(true),
+                            b.get("canReply").and_then(Value::as_bool).unwrap_or(true),
+                            b.get("canResolve").and_then(Value::as_bool).unwrap_or(true),
+                            b.get("canDelete").and_then(Value::as_bool).unwrap_or(true),
+                        ],
+                    );
+                }
+            }
+        }
+        self.sync_host_project(i, id);
+        if let Some(clause) = params.get("selectedId").and_then(Value::as_str) {
+            return self.locate_host_clause(i, id, clause);
+        }
+        Ok(json!({}))
+    }
+    pub(super) fn locate_host_clause(&mut self, i: usize, id: DocId, clause: &str) -> Result<Value, String> {
+        self.sync_host_project(i, id);
+        let p = &self.host_review.as_ref().and_then(|h| h.documents.get(&id)).ok_or("no document")?.project;
+        let target = p.targets.iter().find(|t| t.get("id").and_then(Value::as_str) == Some(clause)).ok_or("unknown clause")?;
+        let found = p.matches.get(clause);
+        let mut status = match found {
+            Some(Ok(m)) if m.len() == 1 => "matched",
+            Some(Ok(m)) if m.len() > 1 => "ambiguous",
+            Some(Ok(_)) => "missing",
+            _ => "unsupported",
+        };
+        self.views[i].clear_selection();
+        if status == "matched" {
+            if let Some(Ok(m)) = found {
+                if let Some((page, quads)) = m.first() {
+                    let page = *page;
+                    if let (Some(r), Some(info)) = (bounds(quads), self.session.get(id).and_then(|d| d.info.pages.get(page))) {
+                        let view = info.user_to_view(r[0] as f32, r[3] as f32);
+                        self.views[i].go_to_page(page);
+                        self.views[i].goto = Some((page, (view[1] / info.height.max(1.0) - 0.03).clamp(0.0, 1.0)));
+                    }
+                    if let Some(doc) = self.session.get(id) {
+                        let mut renderer = pdfcraft_render::PageRenderer::new(
+                            doc.bytes.clone(),
+                            pdfcraft_render::RenderConfig { password: doc.password.as_deref().map(std::sync::Arc::from), ..Default::default() },
+                        );
+                        if let Some(text) = renderer
+                            .render(pdfcraft_render::RenderRequest { page, kind: pdfcraft_render::RequestKind::Text, ..Default::default() })
+                            .text
+                        {
+                            let matches = text.find_opts_limited(target.get("quote").and_then(Value::as_str).unwrap_or(""), true, false, 2);
+                            if matches.len() == 1 {
+                                if let Some(range) = matches.first() {
+                                    let (start, end) = (range.start, range.end.saturating_sub(1));
+                                    self.views[i].texts.insert(page, text);
+                                    self.views[i].select_text(page, start, end);
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        } else if status == "missing" {
+            if let Some(page) = target
+                .get("page")
+                .and_then(Value::as_u64)
+                .and_then(|n| usize::try_from(n).ok())
+                .filter(|page| self.session.get(id).is_some_and(|d| *page < d.info.pages.len()))
+            {
+                self.views[i].go_to_page(page);
+                status = "page";
+            }
+        }
+        let selection =
+            json!({"text":self.views[i].selected_text(),"quads":self.session.get(id).and_then(|d|self.views[i].selection_quads(&d.info))})
+                .to_string();
+        let p = &mut self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)).ok_or("no document")?.project;
+        p.selected = Some(clause.to_string());
+        p.status = status.into();
+        p.selection = selection;
+        Ok(json!({"id":clause,"status":status}))
+    }
+    pub(super) fn host_source_state(&mut self, i: usize, id: DocId) -> Value {
+        self.sync_host_project(i, id);
+        let text = self.views[i].selected_text().unwrap_or_default();
+        let selected = self.session.get(id).and_then(|d| self.views[i].selection_quads(&d.info));
+        let signature = json!({"text":self.views[i].selected_text(),"quads":selected}).to_string();
+        let Some(state) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)) else {
+            return json!({"selectedId":null,"status":"unsupported"});
+        };
+        let p = &mut state.project;
+        if signature != p.selection && !text.is_empty() {
+            if let Some((page, quads)) = selected {
+                if let Some(r) = bounds(&quads) {
+                    let ids: Vec<_> = p
+                        .matches
+                        .iter()
+                        .filter_map(|(id, result)| {
+                            let m = result.as_ref().ok()?;
+                            let (mp, q) = m.first()?;
+                            let b = bounds(q)?;
+                            (m.len() == 1 && page == *mp && r[0] >= b[0] - 2.0 && r[1] >= b[1] - 2.0 && r[2] <= b[2] + 2.0 && r[3] <= b[3] + 2.0)
+                                .then(|| id.clone())
+                        })
+                        .collect();
+                    if ids.len() == 1 {
+                        p.selected = ids.first().cloned();
+                        p.status = "matched".into();
+                    }
+                }
+            }
+            p.selection = signature;
+        }
+        json!({"selectedId":p.selected,"status":if p.status.is_empty(){"unsupported"}else{p.status.as_str()}})
+    }
+    pub(super) fn upsert_host_comment(&mut self, i: usize, id: DocId, params: &Value) -> Result<Value, String> {
+        self.sync_host_project(i, id);
+        let clause = params.get("clauseId").and_then(Value::as_str).ok_or("a clause association is required")?.to_string();
+        let state = self.host_review.as_ref().and_then(|h| h.documents.get(&id)).ok_or("no document")?;
+        let p = &state.project;
+        if !p.configured
+            || !p.editable
+            || !p
+                .targets
+                .iter()
+                .any(|t| t.get("id").and_then(Value::as_str) == Some(clause.as_str()) && t.get("editable").and_then(Value::as_bool) == Some(true))
+        {
+            return Err("this clause is read only".into());
+        }
+        let text = params.get("text").and_then(Value::as_str).ok_or("missing comment text")?.to_string();
+        if text.len() > 1_048_576 {
+            return Err("comment is too long".into());
+        }
+        let replies = params.get("replies").and_then(Value::as_array).cloned().unwrap_or_default();
+        if replies.len() > 1000 {
+            return Err("too many replies".into());
+        }
+        let existing = if params.get("id").is_some_and(|v| !v.is_null()) { Some(numeric_id(params)?) } else { None };
+        let found = if existing.is_none() {
+            let quote = params.get("quote").and_then(Value::as_str).unwrap_or("");
+            let matches = self
+                .session
+                .get(id)
+                .ok_or("no document")?
+                .host_quote_matches(quote, params.get("page").and_then(Value::as_u64).and_then(|n| usize::try_from(n).ok()))?;
+            if matches.len() != 1 {
+                return Err(if matches.is_empty() { "quote missing from source" } else { "quote is ambiguous in source" }.into());
+            }
+            let clause_matches = p.matches.get(&clause).and_then(|r| r.as_ref().ok()).ok_or("clause source is unsupported")?;
+            let a = matches.first().ok_or("quote missing")?;
+            let b = clause_matches.first().filter(|_| clause_matches.len() == 1).ok_or("clause quote is missing or ambiguous")?;
+            let (ar, br) = (bounds(&a.1).ok_or("quote has no geometry")?, bounds(&b.1).ok_or("clause has no geometry")?);
+            if a.0 != b.0 || ar[0] < br[0] - 2.0 || ar[1] < br[1] - 2.0 || ar[2] > br[2] + 2.0 || ar[3] > br[3] + 2.0 {
+                return Err("quote is outside the associated clause".into());
+            }
+            matches.first().cloned()
+        } else {
+            None
+        };
+        let (page, index) = if let Some(numeric) = existing {
+            self.comment_native(numeric)?
+        } else {
+            let page = found.as_ref().map(|m| m.0).ok_or("quote missing")?;
+            let next = self
+                .session
+                .get(id)
+                .ok_or("no document")?
+                .comment_keys()
+                .into_iter()
+                .filter(|(p, _, _)| *p == page)
+                .map(|(_, n, _)| n.saturating_add(1))
+                .max()
+                .unwrap_or(0);
+            (page, next)
+        };
+        let doc = self.session.get(id).ok_or("no document")?;
+        let original = existing.and_then(|_| doc.info.annotations.iter().find(|a| a.page == page && a.index == index));
+        if let Some(a) = original {
+            if !a.is_comment() {
+                return Err("upsert requires a root comment".into());
+            }
+            if a.author.as_deref() != Some(self.comment_prefs.author.as_str()) && a.contents.as_deref().unwrap_or("") != text {
+                return Err("only the comment author may edit it".into());
+            }
+        }
+        let mut edits = Vec::new();
+        if let Some((_, quads)) = found {
+            edits.push(Edit::AddAnnotation(NewAnnotation {
+                page,
+                shape: Shape::TextMarkup { kind: Markup::Highlight, quads },
+                style: Style { color: [1.0, 1.0, 0.0], ..Default::default() },
+                contents: text.clone(),
+                author: params
+                    .get("author")
+                    .and_then(Value::as_str)
+                    .filter(|s| !s.trim().is_empty())
+                    .unwrap_or(&self.comment_prefs.author)
+                    .chars()
+                    .take(200)
+                    .collect(),
+            }));
+        } else if original.is_some_and(|a| a.contents.as_deref().unwrap_or("") != text) {
+            edits.push(Edit::SetAnnotationContents { page, index, text: text.clone() });
+        }
+        let tops = pdfcraft_render::thread_tops(&doc.info.annotations);
+        let mut planned = Vec::new();
+        let mut added = HashSet::new();
+        for r in &replies {
+            let text = r.get("text").and_then(Value::as_str).ok_or("missing reply text")?.to_string();
+            if text.len() > 1_048_576 {
+                return Err("reply is too long".into());
+            }
+            let mut author = r.get("author").and_then(Value::as_str).unwrap_or(&self.comment_prefs.author).to_string();
+            let old = if r.get("id").is_some_and(|v| !v.is_null()) {
+                let numeric = numeric_id(r)?;
+                let at =
+                    state_slot(self.host_review.as_ref().and_then(|h| h.documents.get(&id)).ok_or("no document")?, numeric).ok_or("reply missing")?;
+                let a = doc.info.annotations.iter().find(|a| (a.page, a.index) == at).ok_or("reply missing")?;
+                if tops.get(&at) != Some(&(page, index)) || !a.is_reply() || a.state.is_some() {
+                    return Err("reply belongs to another thread".into());
+                }
+                Some(a)
+            } else {
+                doc.info.annotations.iter().find(|a| {
+                    a.is_reply()
+                        && a.state.is_none()
+                        && tops.get(&(a.page, a.index)) == Some(&(page, index))
+                        && a.author.as_deref() == Some(author.as_str())
+                        && a.contents.as_deref().unwrap_or("") == text
+                })
+            };
+            if let Some(a) = old {
+                author = a.author.clone().unwrap_or_default();
+                if a.contents.as_deref().unwrap_or("") != text {
+                    if a.author.as_deref() != Some(self.comment_prefs.author.as_str()) {
+                        return Err("only the reply author may edit it".into());
+                    }
+                    edits.push(Edit::SetAnnotationContents { page: a.page, index: a.index, text: text.clone() });
+                }
+            } else if added.insert((author.clone(), text.clone())) {
+                edits.push(Edit::ReplyToAnnotation { page, index, text: text.clone(), author: author.clone() });
+            }
+            planned.push((text, author));
+        }
+        let resolved = doc
+            .info
+            .annotations
+            .iter()
+            .rfind(|a| tops.get(&(a.page, a.index)) == Some(&(page, index)) && a.state.is_some() && !a.is_mark())
+            .is_some_and(|a| a.state.as_deref() == Some("Completed"));
+        let desired = params.get("resolved").and_then(Value::as_bool).unwrap_or(false);
+        if resolved != desired {
+            edits.push(Edit::SetAnnotationStatus {
+                page,
+                index,
+                state: if desired { ReviewState::Completed } else { ReviewState::None },
+                author: self.comment_prefs.author.clone(),
+            });
+        }
+        let previous_associations =
+            self.host_review.as_ref().and_then(|h| h.documents.get(&id)).map(|s| s.project.associations.clone()).unwrap_or_default();
+        if let Some(numeric) = existing {
+            let key = self
+                .host_review
+                .as_ref()
+                .and_then(|h| h.documents.get(&id))
+                .and_then(|s| s.native_keys.get(&(page, index)))
+                .cloned()
+                .ok_or("comment key unavailable")?;
+            let p = &mut self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)).ok_or("no document")?.project;
+            p.associations.insert(key, clause.clone());
+            self.sync_host_project(i, id);
+            let _ = numeric;
+        }
+        if !edits.is_empty() {
+            if let Err(error) = self.apply_host_comment(Edit::Batch { label: "Synchronize project comments".into(), edits }, None) {
+                if let Some(s) = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)) {
+                    s.project.associations = previous_associations;
+                }
+                self.sync_host_project(i, id);
+                return Err(error);
+            }
+        }
+        self.sync_host_review();
+        let state = self.host_review.as_mut().and_then(|h| h.documents.get_mut(&id)).ok_or("no document")?;
+        let numeric = *state.native.get(&(page, index)).ok_or("comment identity unavailable")?;
+        let key = state.native_keys.get(&(page, index)).cloned().ok_or("comment key unavailable")?;
+        state.project.associations.insert(key.clone(), clause);
+        state.project.generation = None;
+        let doc = self.session.get(id).ok_or("no document")?;
+        let tops = pdfcraft_render::thread_tops(&doc.info.annotations);
+        let mut output = Vec::new();
+        for (text, author) in planned {
+            let a = doc
+                .info
+                .annotations
+                .iter()
+                .find(|a| {
+                    a.is_reply()
+                        && a.state.is_none()
+                        && tops.get(&(a.page, a.index)) == Some(&(page, index))
+                        && a.author.as_deref() == Some(author.as_str())
+                        && a.contents.as_deref().unwrap_or("") == text
+                })
+                .ok_or("reply identity unavailable")?;
+            output.push(json!({"id":state.native.get(&(a.page,a.index)),"nativeKey":state.native_keys.get(&(a.page,a.index))}));
+        }
+        self.views[i].comments.selected = Some((page, index));
+        self.sync_host_project(i, id);
+        Ok(json!({"id":numeric,"nativeKey":key,"replies":output}))
+    }
+}
+fn state_slot(state: &ReviewDocument, numeric: u32) -> Option<(usize, usize)> {
+    state.native.iter().find(|(_, n)| **n == numeric).map(|(at, _)| *at)
+}
